cmake_minimum_required(VERSION 3.19)
if(WIN32 AND NOT EXISTS "${CLIENT}")
  message(FATAL_ERROR "The Windows Blueprint SSH test requires the local transport fixture")
endif()
string(RANDOM LENGTH 12 id)
set(root "${CMAKE_CURRENT_BINARY_DIR}/blueprint ssh ${id}")
set(bundle "${root}/bundle")
file(MAKE_DIRECTORY "${bundle}")
file(WRITE "${bundle}/main.mjs" [=[
export default () => [
  {op:"copy", payload:"marker", path:"before"},
  {op:"include", module:"./remote.mjs", args:{}},
  {op:"copy", payload:"marker", path:"after"}
];
]=])
file(WRITE "${bundle}/marker" "blueprint marker\n")
set(target "operator@host.example.invalid")
set(allow "${target}:2222")
set(command "echo hello 世界")
set(source "main.mjs[2] > remote.mjs[1]")
set(identity "${root}/operator identity")
set(hosts "${root}/operator host pins")
file(WRITE "${identity}" "private identity fixture bytes")
file(WRITE "${hosts}" "dedicated host fixture bytes")

function(seal extra_fields capability)
  set(second_step "")
  if(ARGC GREATER 2)
    set(second_step ",{op:'ssh',target:'${ARGV2}',port:2222,command:'echo second'}")
  endif()
  file(WRITE "${bundle}/remote.mjs"
    "export default () => [{op:'ssh',target:'${target}',port:2222,command:'${command}',timeoutSeconds:6${extra_fields}}${second_step}];\n")
  file(SHA256 "${bundle}/main.mjs" main_sha)
  file(SHA256 "${bundle}/remote.mjs" remote_sha)
  file(SHA256 "${bundle}/marker" marker_sha)
  file(WRITE "${bundle}/blueprint.manifest"
    "brw-blueprint-v1\nentry\tmain.mjs\nplatform\tany\narch\tany\nrequires\tcopy\n${capability}\tssh\n"
    "module\tmain.mjs\t${main_sha}\nmodule\tremote.mjs\t${remote_sha}\npayload\tmarker\t${marker_sha}\n")
  file(SHA256 "${bundle}/blueprint.manifest" trusted)
  set(trusted "${trusted}" PARENT_SCOPE)
endfunction()

function(expect_field expected)
  string(JSON actual GET "${report}" ${ARGN})
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${scenario} ${ARGN}: expected '${expected}', got '${actual}' in ${report}")
  endif()
endfunction()

# Each scenario starts from an empty workspace. The mock records each client
# process start and every command byte independently of the Blueprint report.
function(check scenario mode allowed expected_status completed step_status connections sends)
  set(work "${root}/${scenario}")
  file(MAKE_DIRECTORY "${work}")
  set(ENV{BRW_FIXTURE_CONNECT} "${work}/connections")
  set(ENV{BRW_FIXTURE_SEND} "${work}/sent")
  set(ENV{BRW_FIXTURE_ARGS} "${work}/argv")
  set(ENV{BRW_FIXTURE_MODE} "${scenario}")
  set(flags)
  if(allowed)
    list(APPEND flags --allow-target "${allowed}" --identity "${identity}" --known-hosts "${hosts}")
  endif()
  if(scenario STREQUAL "dry-run")
    list(APPEND flags --dry-run)
  endif()
  execute_process(COMMAND "${BRW}" blueprint ${mode} "${bundle}" --sha256 "${trusted}"
    --workspace "${work}" ${flags} --json RESULT_VARIABLE rc OUTPUT_VARIABLE report
    ERROR_VARIABLE diagnostics TIMEOUT 12 ENCODING UTF-8)
  if(expected_status STREQUAL "failed")
    set(expected_rc 1)
  else()
    set(expected_rc 0)
  endif()
  if(NOT "${rc}" STREQUAL "${expected_rc}")
    message(FATAL_ERROR "${scenario}: expected exit ${expected_rc}, got ${rc}: ${report} ${diagnostics}")
  endif()
  expect_field("${expected_status}" status)
  expect_field("${completed}" completed)
  if("${report}${diagnostics}" MATCHES "private identity fixture bytes|dedicated host fixture bytes" OR
     "${report}" MATCHES "operator identity|operator host pins")
    message(FATAL_ERROR "${scenario}: SSH credentials in the Blueprint report")
  endif()

  foreach(path before after)
    if((path STREQUAL "before" AND completed GREATER 0) OR (path STREQUAL "after" AND completed EQUAL 3))
      file(READ "${work}/${path}" contents)
      if(NOT contents STREQUAL "blueprint marker\n")
        message(FATAL_ERROR "${scenario}: incorrect ${path} marker")
      endif()
    elseif(EXISTS "${work}/${path}")
      message(FATAL_ERROR "${scenario}: unexpectedly applied ${path} step")
    endif()
  endforeach()
  if(connections)
    file(READ "${work}/connections" starts)
    if(NOT starts STREQUAL "connect\n")
      message(FATAL_ERROR "${scenario}: expected exactly one connection: ${starts}")
    endif()
  elseif(EXISTS "${work}/connections")
    message(FATAL_ERROR "${scenario}: unexpected transport connection")
  endif()
  if(sends)
    file(READ "${work}/sent" bytes)
    if(NOT bytes STREQUAL command)
      message(FATAL_ERROR "${scenario}: expected exactly one copy of the command bytes")
    endif()
  elseif(EXISTS "${work}/sent")
    message(FATAL_ERROR "${scenario}: sent command before authorization or host verification")
  endif()

  if(scenario MATCHES "^unsupported-")
    expect_field("missing-capability" error)
    if(scenario STREQUAL "unsupported-selected")
      expect_field("${source}: ssh" detail)
    endif()
    return()
  elseif(scenario STREQUAL "self-authorization")
    expect_field("invalid-ssh-request" error)
    expect_field("${source}" detail)
    return()
  elseif(mode STREQUAL "lock")
    return()
  endif()
  set(index 1)
  if(scenario STREQUAL "unauthorized-second")
    set(index 2)
    set(source "main.mjs[2] > remote.mjs[2]")
  endif()
  expect_field("ssh" steps ${index} op)
  expect_field("${source}" steps ${index} source)
  expect_field("${step_status}" steps ${index} status)
  string(JSON exit_type TYPE "${report}" steps ${index} remoteExit)
  if(step_status STREQUAL "completed")
    if(scenario STREQUAL "exit255")
      expect_field("255" steps 1 remoteExit)
    else()
      expect_field("0" steps 1 remoteExit)
    endif()
    if(NOT exit_type STREQUAL "NUMBER" OR NOT diagnostics MATCHES "remote output")
      message(FATAL_ERROR "${scenario}: missing confirmed exit or remote output")
    endif()
  elseif(NOT exit_type STREQUAL "NULL")
    message(FATAL_ERROR "${scenario}: expected unconfirmed remoteExit to be null")
  endif()
  if(step_status STREQUAL "planned")
    expect_field("host-identity" steps 1 pending 0)
    expect_field("${target}" steps 1 target)
    expect_field("${command}" steps 1 command)
    expect_field("2222" steps 1 port)
    expect_field("6" steps 1 timeoutSeconds)
  elseif(step_status STREQUAL "unknown")
    expect_field("remote-result-unknown" error)
    expect_field("ON" mayHaveSideEffects)
    string(JSON started ERROR_VARIABLE missing GET "${report}" commandStarted)
    if(NOT missing AND started)
      message(FATAL_ERROR "disconnect: report asserts the unconfirmed remote command started")
    endif()
    expect_field("main.mjs[2] > remote.mjs[2]" steps 2 source)
    string(JSON later_status ERROR_VARIABLE missing GET "${report}" steps 2 status)
    if(NOT missing AND later_status MATCHES "^(completed|unknown|rejected)$")
      message(FATAL_ERROR "disconnect: unvisited SSH step has a transport outcome: ${report}")
    endif()
  elseif(scenario STREQUAL "wrong-port" OR scenario STREQUAL "unauthorized")
    expect_field("unauthorized-target" error)
  endif()
  if(expected_status STREQUAL "failed")
    expect_field("${source}" detail)
  endif()
endfunction()

seal("" requires)
if(WIN32)
  set(ENV{BRW_TEST_SSH_CLIENT} "${CLIENT}")
  check(lock lock "" locked 0 "" 0 0)
  check(preview preview "${allow}" planned 0 planned 0 0)
  check(dry-run apply "${allow}" planned 0 planned 0 0)
  check(unauthorized apply "" failed 0 rejected 0 0)
  check(wrong-port apply "${target}:22" failed 0 rejected 0 0)
  check(identity-mismatch apply "${allow}" failed 1 rejected 1 0)
  check(exit255 apply "${allow}" failed 1 completed 1 1)
  check(success apply "${allow}" applied 3 completed 1 1)
  seal("" requires "${target}")
  check(disconnect apply "${allow}" failed 1 unknown 1 1)
  seal("" requires "different@host.example.invalid")
  check(unauthorized-second apply "${allow}" failed 0 rejected 0 0)
  seal(",allowTarget:'${allow}',identity:'from-bundle',knownHosts:'from-bundle'" requires)
  check(self-authorization apply "" failed 0 "" 0 0)
else()
  foreach(mode preview apply)
    check(unsupported-${mode} ${mode} "" failed 0 "" 0 0)
  endforeach()
  seal("" optional)
  check(unsupported-selected apply "" failed 0 "" 0 0)
endif()
file(REMOVE_RECURSE "${root}")
