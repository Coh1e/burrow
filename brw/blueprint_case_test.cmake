function(expect_case_rejection expected)
  seal()
  foreach(mode preview apply)
    execute_process(COMMAND "${BRW}" blueprint ${mode} "${bundle}" --sha256 "${trusted}"
      --workspace "${work}" --json RESULT_VARIABLE rc OUTPUT_VARIABLE report TIMEOUT 12)
    string(JSON reason GET "${report}" error)
    string(JSON completed GET "${report}" completed)
    string(JSON detail GET "${report}" detail)
    file(GLOB files "${work}/*")
    if(NOT rc STREQUAL "1" OR NOT reason STREQUAL expected OR NOT completed EQUAL 0 OR
       NOT detail STREQUAL "main.mjs[2]" OR files)
      message(SEND_ERROR "${mode}: expected ${expected} before first write; got ${report} files=[${files}]")
    endif()
  endforeach()
endfunction()

function(test_copy_case)
  set(work "${root}/case-work")
  set(bundle "${root}/case-bundle")
  file(MAKE_DIRECTORY "${work}" "${bundle}")
  file(WRITE "${work}/marker" "lower")
  if(EXISTS "${work}/MARKER")
    set(folded TRUE)
  else()
    set(folded FALSE)
    file(WRITE "${work}/MARKER" "upper")
    file(READ "${work}/marker" lower)
    file(READ "${work}/MARKER" upper)
    if(NOT lower STREQUAL "lower" OR NOT upper STREQUAL "upper")
      message(FATAL_ERROR "case probe did not create two distinct files")
    endif()
    file(REMOVE "${work}/MARKER")
  endif()
  file(REMOVE "${work}/marker")
  if(DEFINED BLUEPRINT_EXPECT_FOLDED AND
     ((BLUEPRINT_EXPECT_FOLDED AND NOT folded) OR (NOT BLUEPRINT_EXPECT_FOLDED AND folded)))
    message(FATAL_ERROR "Expected case-insensitive=${BLUEPRINT_EXPECT_FOLDED}, observed ${folded} in ${work}")
  endif()
  file(GLOB before "${work}/*")
  if(before)
    message(FATAL_ERROR "case probe left entries in the workspace: ${before}")
  endif()
  set(modules main.mjs)
  set(payloads first second)
  set(caps copy)
  file(WRITE "${bundle}/first" "one")
  file(WRITE "${bundle}/second" "two")
  file(WRITE "${bundle}/main.mjs" [=[
export default () => [{op:'copy',payload:'first',path:'marker'},
                      {op:'copy',payload:'second',path:'marker'}];
]=])
  expect_case_rejection(destination-exists)
  file(WRITE "${bundle}/main.mjs" [=[
export default () => [{op:'copy',payload:'first',path:'marker'},
                      {op:'copy',payload:'second',path:'MARKER'}];
]=])
  if(BLUEPRINT_UNKNOWN_CASE_ONLY)
    expect_case_rejection(path-case-unknown)
    list(APPEND caps replace)
    file(WRITE "${bundle}/main.mjs" [=[
export default () => [{op:'copy',payload:'first',path:'marker'},
                      {op:'replace',path:'MARKER',from:'one',to:'two',count:1}];
]=])
    expect_case_rejection(path-case-unknown)
    return()
  endif()
  # A shared mount can expose case behavior only through existing names.
  # The dedicated ramfs and unknown-case fixtures exercise empty directories.
  if(NOT BLUEPRINT_COPY_CASE_ONLY)
    file(WRITE "${work}/case-witness" "case lookup")
  endif()
  seal()
  foreach(mode preview apply)
    execute_process(COMMAND "${BRW}" blueprint ${mode} "${bundle}" --sha256 "${trusted}"
      --workspace "${work}" --json RESULT_VARIABLE rc OUTPUT_VARIABLE report TIMEOUT 12)
    string(JSON completed GET "${report}" completed)
    file(GLOB files RELATIVE "${work}" "${work}/*")
    if(NOT BLUEPRINT_COPY_CASE_ONLY)
      list(REMOVE_ITEM files "case-witness")
    endif()
    string(JSON status GET "${report}" status)
    string(JSON reason ERROR_VARIABLE missing GET "${report}" error)
    if(folded)
      if(NOT rc STREQUAL "1" OR NOT status STREQUAL "failed" OR missing OR NOT reason STREQUAL "destination-exists" OR
         NOT completed EQUAL 0 OR files)
        message(SEND_ERROR "case-insensitive ${mode}: rc=${rc} completed=${completed} files=[${files}] ${report}")
      endif()
    elseif(mode STREQUAL "preview")
      if(NOT rc STREQUAL "0" OR NOT status STREQUAL "planned" OR NOT missing OR NOT completed EQUAL 0 OR files)
        message(SEND_ERROR "case-sensitive preview: ${report} files=[${files}]")
      endif()
    else()
      list(LENGTH files file_count)
      if(NOT rc STREQUAL "0" OR NOT status STREQUAL "applied" OR NOT missing OR NOT completed EQUAL 2 OR NOT file_count EQUAL 2)
        message(FATAL_ERROR "case-sensitive apply: ${report} files=[${files}]")
      endif()
      file(READ "${work}/marker" first)
      file(READ "${work}/MARKER" second)
      if(NOT first STREQUAL "one" OR NOT second STREQUAL "two")
        message(FATAL_ERROR "case-sensitive copy contents: ${first}, ${second}")
      endif()
    endif()
    if(DEFINED BLUEPRINT_EXPECT_FOLDED)
      if(missing)
        set(reason "none")
      endif()
      message(STATUS "${mode}: rc=${rc} error=${reason} completed=${completed} files=[${files}]")
    endif()
  endforeach()
  message(STATUS "Blueprint case fixture: case-insensitive=${folded}")
endfunction()
