set(bundle "${root}/lock kit")
set(work "${root}/lock project")
set(repo "${root}/registered repo")
file(MAKE_DIRECTORY "${bundle}" "${work}" "${repo}")
set(ENV{XDG_CONFIG_HOME} "${root}/lock config")
set(ENV{XDG_CACHE_HOME} "${root}/lock cache")
set(ENV{XDG_DATA_HOME} "${root}/lock data")
set(modules main.mjs)
set(payloads "")
set(caps tool run)
set(expected_steps 2)
function(require_tool requirement)
  file(WRITE "${bundle}/main.mjs" "export default () => [
    {op:'run',program:'${CMAKE_COMMAND}',args:['-E','touch','started']},
    {op:'tool',name:'builder',registry:'sdk',version:'${requirement}'}]")
  seal()
  set(trusted "${trusted}" PARENT_SCOPE)
endfunction()
require_tool("1.*")
file(WRITE "${repo}/builder.exe" "builder-one")
file(SHA256 "${repo}/builder.exe" builder_sha)
file(WRITE "${repo}/middle.exe" "middle")
file(WRITE "${repo}/base.exe" "base")
file(SHA256 "${repo}/middle.exe" middle_sha)
file(SHA256 "${repo}/base.exe" base_sha)
set(builder_row "builder\t1.2\texe\tbuilder.exe\t${builder_sha}\tbuilder.exe\tmiddle\n")
set(middle_row "middle\t2\texe\tmiddle.exe\t${middle_sha}\tmiddle.exe\tbase\n")
set(base_row "base\t3\texe\tbase.exe\t${base_sha}\tbase.exe\n")
file(WRITE "${repo}/catalog" "brw-catalog-v1\n${builder_row}${middle_row}${base_row}")
execute_process(COMMAND "${BRW}" source add sdk "${repo}/catalog" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "could not register the SDK source")
endif()
invoke(lock 0)
begin_boundary("4/pinned-version")
invoke(preview 0)
function(lock_field expected index field)
  string(JSON actual GET "${report}" locked ${index} ${field})
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "expected ${index} ${field}=${expected}: ${report}")
  endif()
endfunction()
foreach(i RANGE 0 2)
  lock_field("sdk" ${i} source)
endforeach()
lock_field(base 0 name)
lock_field(3 0 version)
lock_field("${base_sha}" 0 sha256)
lock_field(middle 1 name)
lock_field(2 1 version)
lock_field("${middle_sha}" 1 sha256)
lock_field(builder 2 name)
lock_field(1.2 2 version)
lock_field("${builder_sha}" 2 sha256)
string(JSON target GET "${report}" locked 0 platform)
set(lock "${bundle}/blueprint.${target}.lock")
file(READ "${lock}" initial)
if(EXISTS "${work}/started" OR EXISTS "$ENV{XDG_CACHE_HOME}")
  message(FATAL_ERROR "generating or previewing the lock ran a step or populated the cache")
endif()

file(WRITE "${repo}/new.exe" "builder-ten")
file(SHA256 "${repo}/new.exe" new_sha)
file(APPEND "${repo}/catalog" "builder\t1.10\texe\tnew.exe\t${new_sha}\tbuilder.exe\tmiddle\n")
if(WIN32)
  execute_process(COMMAND "${BRW}" install sdk/builder --dry-run --json
    RESULT_VARIABLE rc OUTPUT_VARIABLE install_report)
  string(JSON error GET "${install_report}" error)
  if(NOT rc EQUAL 1 OR NOT error STREQUAL "package-ambiguous")
    message(FATAL_ERROR "install selection changed: ${install_report}")
  endif()
endif()
invoke(apply 0)
lock_field(1.2 2 version)
set(cache "$ENV{XDG_CACHE_HOME}/burrow")
file(SHA256 "${cache}/artifact-${builder_sha}" obtained)
file(READ "${lock}" after_apply)
if(NOT obtained STREQUAL builder_sha OR NOT initial STREQUAL after_apply)
  message(FATAL_ERROR "ordinary apply changed its resolution")
endif()
observe_boundary("cached builder SHA-256=${obtained}, platform lock byte-identical after apply")
finish_boundary()
begin_boundary("4/cache-reuse")
file(RENAME "${repo}/base.exe" "${repo}/base.offline")
invoke(apply 0)
lock_field(ON 0 reused)
file(WRITE "${cache}/artifact-${base_sha}" "unverified")
invoke(apply 1)
lock_field(OFF 0 reused)
file(RENAME "${repo}/base.offline" "${repo}/base.exe")
invoke(apply 0)
lock_field(OFF 0 reused)
file(SHA256 "${cache}/artifact-${base_sha}" restored)
if(NOT restored STREQUAL base_sha)
  message(FATAL_ERROR "unverified dependency was reused")
endif()
observe_boundary("restored dependency SHA-256=${restored}")
# Match version and original bytes of an already installed single-file dependency.
finish_boundary()
begin_boundary("4/installed-dependency")
file(REMOVE "${cache}/artifact-${base_sha}")
set(installed "$ENV{XDG_DATA_HOME}/burrow/packages/base/3")
file(MAKE_DIRECTORY "${installed}")
configure_file("${repo}/base.exe" "${installed}/base.exe" COPYONLY)
file(RENAME "${repo}/base.exe" "${repo}/base.offline")
invoke(apply 0)
lock_field(ON 0 reused)
file(REMOVE "${cache}/artifact-${base_sha}")
file(WRITE "${installed}/base.exe" "changed locally")
invoke(apply 1)
lock_field(OFF 0 reused)
file(RENAME "${repo}/base.offline" "${repo}/base.exe")
invoke(apply 0)
lock_field(OFF 0 reused)
file(READ "${installed}/base.exe" retained)
if(NOT retained STREQUAL "changed locally")
  message(FATAL_ERROR "apply overwrote an unverified installed dependency")
endif()
observe_boundary("preserved installed file content=${retained}")
finish_boundary()
begin_boundary("4/explicit-update")
invoke(lock 0)
invoke(preview 0)
lock_field(1.10 2 version)
lock_field("${new_sha}" 2 sha256)
file(READ "${lock}" updated)
finish_boundary()
file(REMOVE "${work}/started")
function(lock_reject code package)
  foreach(mode preview apply)
    invoke(${mode} 1)
    string(JSON err GET "${report}" error)
    string(JSON detail GET "${report}" detail)
    string(JSON completed GET "${report}" completed)
    if(NOT err STREQUAL code OR NOT detail STREQUAL "${package} (${target})" OR
       completed OR EXISTS "${work}/started")
      message(FATAL_ERROR "expected ${code} before any write: ${report}")
    endif()
  endforeach()
endfunction()
string(REGEX REPLACE "sdk\tbase\t[^\n]*\n" "" missing "${updated}")
file(WRITE "${lock}" "${missing}")
lock_reject(lock-missing base)
file(READ "${lock}" untouched)
if(NOT untouched STREQUAL missing)
  message(FATAL_ERROR "missing dependency was automatically added")
endif()
file(WRITE "${lock}" "${updated}")
require_tool("2.*")
begin_boundary("4/lock-conflict")
lock_reject(lock-conflict builder)
file(READ "${lock}" untouched)
if(NOT untouched STREQUAL updated)
  message(FATAL_ERROR "conflicting requirement rewrote the lock")
endif()
observe_boundary("platform lock byte-identical, earlier action marker absent")
finish_boundary()
file(REMOVE "${lock}")
lock_reject(lock-missing builder)
if(EXISTS "${lock}")
  message(FATAL_ERROR "ordinary execution generated lock records")
endif()
require_tool("1.*")
string(REPEAT "x" 76 long_name)
file(APPEND "${repo}/catalog" "${long_name}\t1\texe\tHTTPS://example.invalid/probe\t${base_sha}\tbase.exe\n")
invoke(lock 0)
list(APPEND caps state)
file(WRITE "${bundle}/main.mjs" "export default () => [
  {op:'tool',registry:'sdk',name:'builder',version:'1.*'},
  {op:'state',check:{program:'${CMAKE_COMMAND}',args:['-E','false']},unmet:[3],
   change:{program:'unused',args:[]}}]")
seal()
invoke(preview 0)
string(JSON deferred GET "${report}" steps 1 status)
if(NOT deferred STREQUAL "check-at-execution")
  message(FATAL_ERROR "state inspected cache before the tool step: ${report}")
endif()
execute_process(COMMAND "${BRW}" source add SDK "${repo}/catalog" RESULT_VARIABLE duplicate)
if(duplicate EQUAL 0)
  message(FATAL_ERROR "source names must be unique under case-insensitive lookup")
endif()
require_tool("1.*")
if(NOT WIN32)
  # A source row near the input limit grows by the source name when serialized.
  set(prefix "builder\t1.11\texe\thttps://example.invalid/")
  set(suffix "\t${builder_sha}\tbuilder.exe")
  string(LENGTH "${prefix}${suffix}" fixed)
  math(EXPR padding "18431 - ${fixed}")
  string(REPEAT "a" ${padding} url_tail)
  file(APPEND "${repo}/catalog" "${prefix}${url_tail}${suffix}\n")
  invoke(lock 0)
  invoke(preview 0)
  lock_field(1.11 0 version)
  require_tool("1.2")
endif()
file(READ "${lock}" before_cycle)
file(APPEND "${repo}/catalog" "base\t4\texe\tbase.exe\t${base_sha}\tbase.exe\tbuilder\n")
invoke(lock 1)
string(JSON cycle GET "${report}" error)
file(READ "${lock}" after_cycle)
if(NOT cycle STREQUAL "dependency-cycle" OR NOT after_cycle STREQUAL before_cycle)
  message(FATAL_ERROR "generation published a cyclic resolution: ${report}")
endif()
