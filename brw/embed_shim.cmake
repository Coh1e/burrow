file(WRITE "${OUTPUT}" "")
function(embed path symbol)
  file(READ "${path}" bytes HEX)
  string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
  file(APPEND "${OUTPUT}" "static const unsigned char ${symbol}[] = {\n")
  string(LENGTH "${bytes}" length)
  set(offset 0)
  while(offset LESS length)
    string(SUBSTRING "${bytes}" "${offset}" 100 line)
    file(APPEND "${OUTPUT}" "${line}\n")
    math(EXPR offset "${offset} + 100")
  endwhile()
  file(APPEND "${OUTPUT}" "};\n")
endfunction()
embed("${INPUT}" shim_image)
embed("${GUI}" gui_shim_image)
