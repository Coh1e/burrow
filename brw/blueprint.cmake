cmake_minimum_required(VERSION 3.19)
include(quickjs.cmake)
if(WIN32)
  set(bp_os windows)
elseif(APPLE)
  set(bp_os macos)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(bp_os linux)
else()
  message(FATAL_ERROR "Unsupported Blueprint platform: ${CMAKE_SYSTEM_NAME}")
endif()
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" bp_arch)
if(bp_arch MATCHES "^(amd64|x86_64)$")
  set(bp_arch x86_64)
elseif(bp_arch MATCHES "^(arm64|aarch64)$")
  set(bp_arch arm64)
endif()
add_library(brw_blueprint_core STATIC blueprint_js.c blueprint_bundle.c)
target_link_libraries(brw_blueprint_core PRIVATE brw_quickjs brw_verified_files digby)
add_library(brw_blueprint STATIC blueprint_cli.c blueprint_lock.c blueprint_lock_${brw_file_backend}.c
  blueprint_run.c blueprint_edit.c blueprint_${brw_file_backend}.c)
target_link_libraries(brw_blueprint PRIVATE brw_blueprint_core digby digby_archive)
target_include_directories(brw_blueprint PRIVATE "${bp_sha_source}")
if(NOT WIN32)
  target_include_directories(brw_blueprint PRIVATE "${archive_source}/libarchive")
  target_link_libraries(brw_blueprint PRIVATE archive_static)
endif()
target_compile_definitions(brw_blueprint PRIVATE BRW_BP_PLATFORM="${bp_os}" BRW_BP_ARCH="${bp_arch}")
if(WIN32)
  target_compile_definitions(brw_blueprint PRIVATE BRW_BP_NATIVE_INSTALL)
  target_link_libraries(brw_blueprint PRIVATE ntdll bcrypt)
elseif(APPLE)
  target_compile_definitions(brw_blueprint_core PRIVATE _DARWIN_C_SOURCE)
  target_compile_definitions(brw_blueprint PRIVATE _DARWIN_C_SOURCE)
endif()
foreach(target brw_blueprint brw_blueprint_core)
  set_target_properties(${target} PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
  target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
endforeach()
if(BUILD_TESTING)
  # Python runs the fixture. An offline build of brw itself does not need it.
  find_package(Python3 QUIET COMPONENTS Interpreter)
  if(NOT Python3_Interpreter_FOUND)
    set(Python3_EXECUTABLE python3)
  endif()
  add_test(NAME blueprint_unpack COMMAND "${Python3_EXECUTABLE}"
    "${CMAKE_CURRENT_SOURCE_DIR}/../tests/blueprint-unpack.py" "$<TARGET_FILE:brw>")
  if(NOT WIN32)
    add_executable(digby_archive_posix_test digby_archive_posix_test.c)
    target_link_libraries(digby_archive_posix_test PRIVATE digby_archive)
    add_test(NAME digby_archive_rollback COMMAND digby_archive_posix_test)
  endif()
  add_executable(blueprint_plan_test blueprint_plan_test.c)
  target_link_libraries(blueprint_plan_test PRIVATE brw_blueprint_core)
  add_test(NAME blueprint_plan COMMAND blueprint_plan_test)
  set(bp_fixture_args "")
  if(WIN32)
    set(bp_ssh_fixture "-DBRW=$<TARGET_FILE:brw_test_interrupt>" "-DCLIENT=$<TARGET_FILE:brw_test_ssh_client>")
    list(APPEND bp_fixture_args "-DPAYLOAD=$<TARGET_FILE:brw_test_payload>"
      "-DINTERRUPT_BRW=$<TARGET_FILE:brw_test_interrupt>" "-DGUI_SHIM=$<TARGET_FILE:brw_gui_shim>")
    foreach(version IN ITEMS 1 2)
      add_executable(blueprint_test_tool_${version} test_tool_version.c)
      target_compile_definitions(blueprint_test_tool_${version} PRIVATE TOOL_VERSION="${version}")
      list(APPEND bp_fixture_args "-DTOOL_${version}=$<TARGET_FILE:blueprint_test_tool_${version}>")
    endforeach()
  else()
    set(bp_ssh_fixture "-DBRW=$<TARGET_FILE:brw>")
  endif()
  add_test(NAME blueprint_ssh COMMAND "${CMAKE_COMMAND}" ${bp_ssh_fixture}
    -P "${CMAKE_CURRENT_SOURCE_DIR}/blueprint_ssh_test.cmake")
  add_test(NAME blueprint_cli COMMAND "${CMAKE_COMMAND}" "-DBRW=$<TARGET_FILE:brw>" ${bp_fixture_args}
    -P "${CMAKE_CURRENT_SOURCE_DIR}/blueprint_test.cmake")
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    add_test(NAME blueprint_cli_ramfs COMMAND sh "${CMAKE_CURRENT_SOURCE_DIR}/blueprint_ramfs_test.sh"
      "${CMAKE_COMMAND}" "-DBRW=$<TARGET_FILE:brw>" -DBLUEPRINT_COPY_CASE_ONLY=ON
      -P "${CMAKE_CURRENT_SOURCE_DIR}/blueprint_test.cmake")
    set_tests_properties(blueprint_cli_ramfs PROPERTIES SKIP_RETURN_CODE 77)
    add_test(NAME blueprint_cli_unknown_case COMMAND sh "${CMAKE_CURRENT_SOURCE_DIR}/blueprint_unknown_case_test.sh"
      "${CMAKE_COMMAND}" "-DBRW=$<TARGET_FILE:brw>" -DBLUEPRINT_UNKNOWN_CASE_ONLY=ON
      -P "${CMAKE_CURRENT_SOURCE_DIR}/blueprint_test.cmake")
    set_tests_properties(blueprint_cli_unknown_case PROPERTIES SKIP_RETURN_CODE 77)
  endif()
endif()
