set(bundle "${root}/command kit")
set(work "${root}/project dir")
file(MAKE_DIRECTORY "${bundle}/child" "${work}" "${root}/launcher")
file(WRITE "${bundle}/main.mjs" "export default () => [{op:'include',module:'child/build.mjs',args:{}}]")
set(child [=[
export default () => [{op:'run',program:'@CMAKE_COMMAND@',
  args:['-P',{payload:'probe.cmake'},'two words','|','']}]
]=])
string(CONFIGURE "${child}" child @ONLY)
file(WRITE "${bundle}/child/build.mjs" "${child}")
file(WRITE "${bundle}/child/probe.cmake" [=[
if(NOT CMAKE_ARGC EQUAL 6 OR NOT CMAKE_ARGV3 STREQUAL "two words" OR
   NOT CMAKE_ARGV4 STREQUAL "|" OR NOT CMAKE_ARGV5 STREQUAL "")
  message(FATAL_ERROR "incorrect argv")
endif()
message("running verified script")
file(WRITE "action.marker" "${CMAKE_CURRENT_BINARY_DIR}")
file(WRITE "staged-path" "${CMAKE_SCRIPT_MODE_FILE}")
]=])
set(modules main.mjs child/build.mjs)
set(payloads child/probe.cmake)
set(caps run)
seal()
set(expected_steps 1)
set(boundary "7/literal-pipe")
foreach(mode preview apply)
  invoke(${mode} 0 "../command kit" "../project dir" "${root}/launcher")
  string(JSON program GET "${report}" steps 0 program)
  string(JSON arg GET "${report}" steps 0 args 2)
  string(JSON script GET "${report}" steps 0 args 1 payload)
  if(NOT program STREQUAL CMAKE_COMMAND OR NOT arg STREQUAL "two words" OR
     NOT script STREQUAL "child/probe.cmake")
    message(FATAL_ERROR "incorrect command report: ${report}")
  endif()
  if(mode STREQUAL "preview" AND EXISTS "${work}/action.marker")
    message(FATAL_ERROR "preview ran the command")
  endif()
endforeach()
file(READ "${work}/action.marker" cwd)
file(READ "${work}/staged-path" staged)
get_filename_component(staged_name "${staged}" NAME)
if(EXISTS "${staged}" OR NOT staged_name STREQUAL "probe.cmake")
  message(FATAL_ERROR "unexpected staged script after apply: ${staged}")
endif()
if(NOT cwd STREQUAL work)
  message(FATAL_ERROR "unexpected working directory: ${cwd}")
endif()
observe_boundary("Probe accepted the literal pipe, empty argument and space-containing argument in ${cwd}")

if(WIN32)
  set(shell [=[{program:'powershell.exe',args:['-NoProfile','-Command',
    "'pipeline' | Set-Content -NoNewline pipeline.marker"]}]=])
else()
  set(shell [=[{program:'sh',args:['-c',"printf pipeline | cat > pipeline.marker"]}]=])
endif()
file(WRITE "${bundle}/child/build.mjs" "export default () => [{op:'run',...${shell}}]")
seal()
set(boundary "7/interpreter-pipe")
invoke(apply 0)
file(READ "${work}/pipeline.marker" pipeline)
if(NOT pipeline STREQUAL "pipeline")
  message(FATAL_ERROR "explicit interpreter pipeline produced: ${pipeline}")
endif()
observe_boundary("pipeline.marker=${pipeline}")
unset(boundary)

file(WRITE "${bundle}/child/build.mjs" "export default () => [{op:'run',program:'missing-brw-command-137',args:[]}]")
seal()
invoke(apply 1)
string(JSON error GET "${report}" error)
if(NOT error STREQUAL "child-launch")
  message(FATAL_ERROR "unexpected launch failure: ${report}")
endif()
file(WRITE "${bundle}/child/build.mjs" "export default () => [{op:'run',program:'unused',args:[123]}]")
set(work "${root}/invalid command project")
file(MAKE_DIRECTORY "${work}")
seal()
reject(invalid-command)
file(WRITE "${bundle}/child/build.mjs" "export default () => [{op:'run',program:'unused',args:[{payload:'missing.cmake'}]}]")
seal()
reject(invalid-payload)
file(WRITE "${bundle}/child/build.mjs" "export default () => [
  {op:'run',program:'${CMAKE_COMMAND}',args:['-E','false']},
  {op:'run',program:'${CMAKE_COMMAND}',args:['-E','touch','unexpected.marker']}]")
seal()
invoke(apply 1)
string(JSON error GET "${report}" error)
string(JSON completed GET "${report}" completed)
if(NOT error STREQUAL "child-failed" OR completed OR EXISTS "${work}/unexpected.marker")
  message(FATAL_ERROR "expected execution to stop at the failed command: ${report}")
endif()
if(WIN32)
  file(WRITE "${bundle}/child/build.mjs" "export default () => [
    {op:'run',program:'${CMAKE_COMMAND}',args:['-E','touch','unexpected.marker']},
    {op:'run',program:'unused',args:Array(9).fill('a'.repeat(4096))}]")
  seal()
  reject(child-command-too-long)
  configure_file("$ENV{ComSpec}" "${work}/local tool.exe" COPYONLY)
  file(WRITE "${bundle}/child/build.mjs" "export default () => [
    {op:'run',program:'./local tool.exe',args:['/d','/c','exit 0']}]")
  seal()
  invoke(apply 0)
endif()
