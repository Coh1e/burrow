set(bundle "${root}/host kit")
set(work "${root}/host workspace")
file(MAKE_DIRECTORY "${bundle}" "${work}")
set(modules main.mjs)
set(payloads probe.cmake action.cmake)
set(caps host run)
file(WRITE "${bundle}/probe.cmake" [=[
file(APPEND calls "check\n")
message("diagnostic from the probe")
execute_process(COMMAND "${CMAKE_COMMAND}" -E cat driver-version COMMAND_ERROR_IS_FATAL ANY)
]=])
file(WRITE "${bundle}/action.cmake" [=[
file(APPEND calls "${CMAKE_ARGV3}\n")
if(CMAKE_ARGV3 STREQUAL "repair")
  file(WRITE driver-version "${CMAKE_ARGV4}\n")
endif()
]=])
set(action "{payload:'action.cmake'}")
set(dependent "{op:'run',program:'${CMAKE_COMMAND}',args:['-P',${action},'dependent']}")
set(probe "{program:'${CMAKE_COMMAND}',args:['-P',{payload:'probe.cmake'}]}")
set(required "'driver 2'")
function(host_fixture)
  file(WRITE "${bundle}/main.mjs" "export default () => [
    ${before_host}{op:'host',required:${required},check:${probe}${repair}},${dependent}]")
  seal()
  set(trusted "${trusted}" PARENT_SCOPE)
endfunction()
function(expect_calls expected)
  file(READ "${work}/calls" calls)
  if(NOT calls STREQUAL expected)
    message(FATAL_ERROR "expected calls [${expected}], got [${calls}]")
  endif()
  string(REPLACE "\n" " " ordered "${calls}")
  observe_boundary("observed calls: ${ordered}")
endfunction()
set(repair "")
set(before_host "")
host_fixture()
file(WRITE "${work}/driver-version" "driver 1\n")
begin_boundary("6/unmet-host")
foreach(mode preview apply)
  file(WRITE "${work}/calls" "")
  invoke(${mode} 1)
  expect_field(host-requirement-unmet error)
  expect_field("main.mjs[1]" detail)
  expect_field("driver 1" steps 0 detected)
  expect_field("driver 2" steps 0 required)
  expect_field(0 completed)
  expect_calls("check\n")
endforeach()
finish_boundary()

# A requirement without a repair cannot change the planned file destinations.
function(check_duplicate_host_copy)
  list(APPEND caps copy)
  set(dependent "{op:'copy',payload:'action.cmake',path:'duplicate'}")
  set(before_host "${dependent},")
  host_fixture()
  file(WRITE "${work}/driver-version" "driver 2\n")
  file(WRITE "${work}/calls" "")
  foreach(mode preview apply)
    invoke(${mode} 1)
    expect_field(destination-exists error)
    expect_field("main.mjs[3]" detail)
    expect_field(0 completed)
    expect_calls("")
    if(EXISTS "${work}/duplicate")
      message(FATAL_ERROR "${mode} published the duplicate destination")
    endif()
  endforeach()
endfunction()
check_duplicate_host_copy()

set(expected_steps 2)
foreach(after_repair "driver 3" "driver 2")
  if(after_repair STREQUAL "driver 2")
    begin_boundary("6/repair-succeeds")
  else()
    begin_boundary("6/repair-fails")
  endif()
  file(WRITE "${work}/driver-version" "driver 1\n")
  file(WRITE "${work}/calls" "")
  set(repair ",repair:{program:'${CMAKE_COMMAND}',args:['-P',${action},'repair','${after_repair}']}")
  host_fixture()
  invoke(preview 0)
  expect_field(unmet steps 0 status)
  expect_field("driver 1" steps 0 detected)
  expect_field("probe.cmake" steps 0 check args 1 payload)
  expect_field(repair steps 0 onMismatch 0)
  expect_field(recheck steps 0 onMismatch 1)
  expect_field("${after_repair}" steps 0 repair args 3)
  expect_field(dependent steps 1 args 2)
  expect_calls("check\n")

  file(WRITE "${work}/calls" "")
  if(after_repair STREQUAL "driver 3")
    invoke(apply 1)
    expect_field(recheck-unmet error)
    expect_field("main.mjs[1]" detail)
    expect_field("driver 2" steps 0 required)
    expect_field("driver 3" steps 0 detected)
    expect_field(0 completed)
    expect_calls("check\nrepair\ncheck\n")
  else()
    invoke(apply 0)
    expect_field(changed steps 0 status)
    expect_field("driver 2" steps 0 detected)
    expect_calls("check\nrepair\ncheck\ndependent\n")
    file(WRITE "${work}/calls" "")
    invoke(apply 0)
    expect_field(satisfied steps 0 status)
    expect_calls("check\ndependent\n")
  endif()
  finish_boundary()
endforeach()

# A previous action supplies the driver mode at execution time.
set(repair "")
set(before_host "{op:'run',program:'${CMAKE_COMMAND}',args:['-P',${action},'repair','driver 2']},")
host_fixture()
file(WRITE "${work}/calls" "")
file(WRITE "${work}/driver-version" "driver 1")
invoke(preview 0)
expect_field(check-at-execution steps 1 status)
expect_calls("")
set(expected_steps 3)
invoke(apply 0)
expect_field(satisfied steps 1 status)
expect_calls("repair\ncheck\ndependent\n")

# A failed or malformed check must never authorize the repair.
set(before_host "")
set(repair ",repair:{program:'${CMAKE_COMMAND}',args:['-P',${action},'repair','driver 2']}")
host_fixture()
string(REPEAT "x" 4097 oversized)
foreach(value "" "driver 2\nextra" "${oversized}")
  file(WRITE "${work}/calls" "")
  file(WRITE "${work}/driver-version" "${value}")
  invoke(apply 1)
  if(value STREQUAL "")
    expect_field(missing-output error)
  else()
    expect_field(invalid-output error)
  endif()
  expect_calls("check\n")
endforeach()
file(REMOVE "${work}/driver-version")
file(WRITE "${work}/calls" "")
invoke(apply 1)
expect_field(check-failed error)
expect_calls("check\n")

file(WRITE "${work}/driver-version" "driver 1")
file(WRITE "${work}/calls" "")
set(repair ",repair:{program:'${CMAKE_COMMAND}',args:['-E','false']}")
host_fixture()
invoke(apply 1)
expect_field(child-failed error)
expect_field("driver 1" steps 0 detected)
expect_calls("check\n")

# A repair can finish even if the recheck itself cannot start.
if(WIN32)
  set(probe_exe "host probe.exe")
  configure_file("$ENV{ComSpec}" "${work}/${probe_exe}" COPYONLY)
  set(probe_args "'/d','/c','echo driver 1'")
else()
  set(probe_exe "host probe")
  configure_file("/bin/sh" "${work}/${probe_exe}" COPYONLY)
  set(probe_args "'-c','echo driver 1'")
endif()
set(probe "{program:'./${probe_exe}',args:[${probe_args}]}")
set(repair ",repair:{program:'${CMAKE_COMMAND}',args:['-E','rm','${probe_exe}']}")
host_fixture()
file(WRITE "${work}/calls" "")
invoke(preview 0)
expect_field(unmet steps 0 status)
expect_field("driver 1" steps 0 detected)
invoke(apply 1)
expect_field(child-launch error)
expect_field(ON repairCompleted)
expect_field(ON mayHaveSideEffects)
string(JSON started ERROR_VARIABLE absent GET "${report}" commandStarted)
if((NOT absent AND started) OR EXISTS "${work}/${probe_exe}")
  message(FATAL_ERROR "incorrect repair or recheck outcome: ${report}")
endif()
expect_calls("")

file(WRITE "${work}/calls" "")
set(before_host "${dependent},")
set(repair ",repair:null")
host_fixture()
invoke(apply 1)
expect_field(invalid-command error)
expect_field("main.mjs[2]" detail)
expect_calls("")
set(repair "")
foreach(required "''" "3" "'a\\nb'")
  host_fixture()
  invoke(apply 1)
  expect_field(invalid-host-requirement error)
  expect_field("main.mjs[2]" detail)
  expect_calls("")
endforeach()

# The probe can report the requested version while the driver is still unavailable.
file(WRITE "${bundle}/probe.cmake" [=[
file(APPEND calls "check\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "driver 2")
if(NOT EXISTS driver-ready)
  message(FATAL_ERROR "driver unavailable")
endif()
]=])
set(probe "{program:'${CMAKE_COMMAND}',args:['-P',{payload:'probe.cmake'}]}")
file(WRITE "${bundle}/main.mjs" "export default () => [
  {op:'host',required:'driver 2',unmet:[1],check:${probe},
   repair:{program:'${CMAKE_COMMAND}',args:['-E','touch','driver-ready']}},${dependent}]")
seal()
set(expected_steps 2)
file(WRITE "${work}/calls" "")
invoke(preview 0)
expect_field(1 steps 0 unmet 0)
expect_field(1 steps 0 exitCode)
expect_field(unmet steps 0 status)
expect_field("driver 2" steps 0 detected)
expect_calls("check\n")
file(WRITE "${work}/calls" "")
invoke(apply 0)
expect_field(changed steps 0 status)
expect_field(0 steps 0 exitCode)
expect_calls("check\ncheck\ndependent\n")

file(WRITE "${work}/calls" "")
foreach(mapping "null" "[0]" "[1,1]")
  file(WRITE "${bundle}/main.mjs" "export default () => [
    {op:'host',required:'driver 2',unmet:${mapping},check:${probe}}]")
  seal()
  invoke(apply 1)
  expect_field(invalid-unmet-codes error)
  expect_calls("")
endforeach()
