# Exercise the same C API on every host, using Git as an independent oracle.
string(RANDOM LENGTH 12 id)
set(root "${CMAKE_CURRENT_BINARY_DIR}/git-contract-${id}")
file(MAKE_DIRECTORY "${root}/source")
function(run expected)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${root}" RESULT_VARIABLE rc
    OUTPUT_VARIABLE out OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT rc EQUAL expected)
    message(FATAL_ERROR "${ARGN} returned ${rc}: ${out}")
  endif()
  set(result "${out}" PARENT_SCOPE)
endfunction()
function(commit dir value)
  file(WRITE "${root}/${dir}/payload" "${value}\n")
  run(0 git -C ${dir} add payload)
  run(0 git -C ${dir} -c user.name=Fixture -c user.email=fixture@example.invalid commit -qm "${value}")
  run(0 git -C ${dir} rev-parse HEAD)
  set(expected "${result}" PARENT_SCOPE)
endfunction()
function(check value)
  if(NOT "${result}" STREQUAL "${value}")
    message(FATAL_ERROR "expected ${value}, received ${result}")
  endif()
endfunction()
run(0 git -C source init -q)
commit(source first)
run(0 "${RUNNER}" clone "${root}/source" tree)
check("${expected}")
commit(source second)
run(0 "${RUNNER}" pull tree)
check("${expected}")
file(READ "${root}/tree/payload" contents)
string(STRIP "${contents}" result)
check(second)
file(WRITE "${root}/tree/payload" "mine\n")
run(1 "${RUNNER}" pull tree)
check(dirty-worktree)
commit(tree mine)
set(local "${expected}")
commit(source third)
run(1 "${RUNNER}" pull tree)
check(non-fast-forward)
run(0 git -C tree rev-parse HEAD)
check("${local}")
file(REMOVE_RECURSE "${root}")
