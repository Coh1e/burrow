set(bundle "${root}/retry kit")
set(work "${root}/retry workspace")
file(MAKE_DIRECTORY "${bundle}" "${work}")
set(modules main.mjs build.mjs test.mjs)
set(payloads action.cmake)
set(caps state run)
set(expected_steps 4)
file(WRITE "${work}/expected-ready" "ready")
file(WRITE "${work}/fail-release" "")
file(WRITE "${bundle}/main.mjs" "export default () => [
  {op:'state',unmet:[1],check:{program:'${CMAKE_COMMAND}',args:['-E','compare_files','expected-ready','ready']},
    change:{program:'${CMAKE_COMMAND}',args:['-P',{payload:'action.cmake'},'prepare']}},
  {op:'include',module:'build.mjs',args:{mode:'Debug'}},
  {op:'include',module:'build.mjs',args:{mode:'Release'}},
  {op:'include',module:'test.mjs',args:{archive:{from:3,output:'archive'}}}]")
file(WRITE "${bundle}/build.mjs" "export const inputs=['mode'];
export const outputs=['archive'];
export default ({mode}) => [{op:'run',program:'${CMAKE_COMMAND}',
  args:['-P',{payload:'action.cmake'},mode,{outputFile:'archive'}]}]")
file(WRITE "${bundle}/test.mjs" "export const inputs=['archive'];
export default ({archive}) => [{op:'run',program:'${CMAKE_COMMAND}',
  args:['-P',{payload:'action.cmake'},'test',archive]}]")
file(WRITE "${bundle}/action.cmake" [=[
set(action "${CMAKE_ARGV3}")
file(APPEND calls "${action}\n")
if(action STREQUAL "prepare")
  file(WRITE ready "ready")
elseif(action STREQUAL "test")
  file(READ "${CMAKE_ARGV4}" archive)
  file(WRITE tested "${archive}")
else()
  if(action STREQUAL "Release" AND EXISTS fail-release)
    file(WRITE Release.archive "partial")
    message(FATAL_ERROR "Release failed after writing its archive")
  endif()
  file(WRITE "${action}.archive" "${action}")
  file(WRITE "${CMAKE_ARGV4}" "${action}.archive")
endif()
]=])
seal()
invoke(preview 0)
expect_field(unmet steps 0 status)
expect_field("main.mjs[2] > build.mjs[1]" steps 1 source)
expect_field(Debug steps 1 args 2)
expect_field("main.mjs[3] > build.mjs[1]" steps 2 source)
expect_field(Release steps 2 args 2)
string(JSON release_source GET "${report}" steps 2 source)
expect_field("main.mjs[4] > test.mjs[1]" steps 3 source)
expect_field("main.mjs[3]" steps 3 args 3 from)
expect_field(archive steps 3 args 3 output)
if(EXISTS "${work}/calls")
  message(FATAL_ERROR "preview ran a build, test or state change")
endif()

function(expect_retry_file path expected)
  file(READ "${work}/${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${path}: expected '${expected}', got '${actual}'")
  endif()
endfunction()
function(expect_retry_flags started)
  foreach(field commandStarted mayHaveSideEffects)
    string(JSON type ERROR_VARIABLE missing TYPE "${report}" "${field}")
    if(missing AND NOT started)
      continue()
    endif()
    if(NOT type STREQUAL "BOOLEAN")
      message(FATAL_ERROR "expected boolean ${field} on command failure: ${report}")
    endif()
    expect_field("${started}" "${field}")
  endforeach()
endfunction()
invoke(apply 1)
expect_field(child-failed error)
expect_field("${release_source}" detail)
expect_field(2 completed)
expect_retry_flags(ON)
set(first_calls "prepare\nDebug\nRelease\n")
expect_retry_file(calls "${first_calls}")
expect_retry_file(Debug.archive "Debug")
expect_retry_file(Release.archive "partial")
if(EXISTS "${work}/tested")
  message(FATAL_ERROR "test consumed an incomplete Release archive")
endif()

file(REMOVE "${work}/fail-release")
set(expected_calls "${first_calls}")
foreach(attempt RANGE 1 2)
  invoke(apply 0)
  expect_field(satisfied steps 0 status)
  string(APPEND expected_calls "Debug\nRelease\ntest\n")
  expect_retry_file(calls "${expected_calls}")
  expect_retry_file(Release.archive "Release")
  expect_retry_file(tested "Release")
endforeach()

# An earlier successful process must not mark a later launch failure as started.
file(WRITE "${bundle}/main.mjs" "export default () => [
  {op:'run',program:'${CMAKE_COMMAND}',args:['-E','true']},
  {op:'run',program:'missing-brw-retry-140',args:[]}]")
seal()
invoke(apply 1)
expect_field(child-launch error)
expect_field("main.mjs[2]" detail)
expect_field(1 completed)
expect_retry_flags(OFF)

function(expect_retry_diagnostic code)
  execute_process(COMMAND "${BRW}" blueprint apply "${bundle}" --sha256 "${trusted}" --workspace "${work}"
    RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE diagnostic TIMEOUT 12)
  if(NOT "${rc}" STREQUAL "1" OR NOT diagnostic MATCHES "${code}")
    message(FATAL_ERROR "expected ${code}, got exit ${rc}: ${diagnostic}")
  endif()
  if((code STREQUAL "child-failed" AND NOT diagnostic MATCHES "command started.*may have left side effects") OR
     (code STREQUAL "child-launch" AND diagnostic MATCHES "command started|side effects"))
    message(FATAL_ERROR "unexpected diagnostic for ${code}: ${diagnostic}")
  endif()
endfunction()
expect_retry_diagnostic(child-launch)
file(WRITE "${bundle}/main.mjs" "export default () => [
  {op:'run',program:'${CMAKE_COMMAND}',args:['-E','false']}]")
seal()
expect_retry_diagnostic(child-failed)
