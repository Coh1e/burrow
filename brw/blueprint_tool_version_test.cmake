set(bundle "${root}/version kit")
set(work "${root}/version workspace")
set(repo "${root}/version catalog")
set(bin "${root}/version bin")
file(MAKE_DIRECTORY "${bundle}" "${work}" "${repo}" "${bin}")
set(ENV{BRW_BIN_DIR} "${bin}")
foreach(dir CONFIG CACHE DATA STATE)
  set(ENV{XDG_${dir}_HOME} "${root}/version ${dir}")
endforeach()
if(WIN32)
  set(command_name builder.exe)
  set(ENV{PATH} "${bin};$ENV{PATH}")
else()
  set(command_name builder)
  set(ENV{PATH} "${bin}:$ENV{PATH}")
endif()
set(default_entry "${bin}/${command_name}")
set(rows "brw-catalog-v1\n")
foreach(version IN ITEMS 1 2)
  set(file_name "v${version}.exe")
  if(WIN32)
    configure_file("${TOOL_${version}}" "${repo}/${file_name}" COPYONLY)
  else()
    file(WRITE "${repo}/${file_name}" "#!/bin/sh\nif [ \"$#\" -eq 0 ]; then echo ${version}; else printf %s ${version} > \"$1\"; fi\n")
    file(CHMOD "${repo}/${file_name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  endif()
  file(SHA256 "${repo}/${file_name}" hash)
  set(package_name builder)
  if(version EQUAL 2)
    set(package_name Builder)
  endif()
  string(APPEND rows "${package_name}\t${version}\texe\t${file_name}\t${hash}\t${command_name}\n")
  if(version EQUAL 1)
    file(WRITE "${repo}/catalog" "${rows}")
    execute_process(COMMAND "${BRW}" source add sdk "${repo}/catalog" COMMAND_ERROR_IS_FATAL ANY)
    if(WIN32)
      execute_process(COMMAND "${BRW}" install sdk/builder --json COMMAND_ERROR_IS_FATAL ANY)
    else()
      set(installed "$ENV{XDG_DATA_HOME}/burrow/packages/builder/1")
      file(MAKE_DIRECTORY "${installed}")
      configure_file("${repo}/${file_name}" "${installed}/${command_name}" COPYONLY)
      file(CREATE_LINK "${installed}/${command_name}" "${default_entry}" SYMBOLIC)
    endif()
  endif()
endforeach()
file(WRITE "${repo}/catalog" "${rows}")

function(check_default version)
  execute_process(COMMAND "${default_entry}" OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY)
  if(NOT actual STREQUAL version)
    message(FATAL_ERROR "expected default entry to run version ${version}, got '${actual}'")
  endif()
endfunction()

check_default(1)

set(modules main.mjs)
set(payloads "")
set(caps tool run)
set(expected_steps 2)
set(select_tool "{op:'tool',registry:'sdk',name:'builder',version:'2'}")
file(WRITE "${bundle}/main.mjs" "export default () => [${select_tool},
  {op:'run',tool:'builder',args:['actual version']}]")
seal()
invoke(lock 0)
invoke(preview 0)
check_default(1)
if(EXISTS "${work}/actual version")
  message(FATAL_ERROR "preview executed the locked tool")
endif()
invoke(apply 0)
file(READ "${work}/actual version" actual)
if(NOT actual STREQUAL "2")
  message(FATAL_ERROR "the locked action ran version '${actual}'")
endif()
check_default(1)

# Switching the user's entry is a separate desired state in its own Blueprint.
function(check_entry_status expected)
  string(JSON actual GET "${report}" steps 1 status)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "expected default entry status ${expected}: ${report}")
  endif()
endfunction()
set(caps tool default)
file(WRITE "${bundle}/main.mjs" "export default () => [${select_tool},
  {op:'default',tool:'builder'}]")
seal()
invoke(preview 0)
string(JSON affected GET "${report}" steps 1 entry)
file(TO_CMAKE_PATH "${affected}" affected)
set(expected_entry "${default_entry}")
if(WIN32)
  string(TOLOWER "${affected}" affected)
  string(TOLOWER "${expected_entry}" expected_entry)
endif()
if(NOT affected STREQUAL expected_entry)
  message(FATAL_ERROR "expected preview to list '${default_entry}', got '${affected}'")
endif()
check_entry_status(unmet)
check_default(1)
invoke(apply 0)
check_entry_status(changed)
check_default(2)
invoke(preview 0)
check_entry_status(satisfied)
invoke(apply 0)
check_entry_status(satisfied)
check_default(2)

set(installed_v2 "$ENV{XDG_DATA_HOME}/burrow/packages/builder/2/${command_name}")
configure_file("${repo}/v1.exe" "${installed_v2}" COPYONLY)
check_modified_payload("${installed_v2}" "${default_entry}")
configure_file("${repo}/v2.exe" "${installed_v2}" COPYONLY)
invoke(preview 0)
check_entry_status(satisfied)

set(caps tool run default)
file(WRITE "${bundle}/main.mjs" "export default () => [${select_tool},
  {op:'run',program:'${CMAKE_COMMAND}',args:['-E','true']},{op:'default',tool:'builder'}]")
seal()
invoke(preview 0)
string(JSON deferred GET "${report}" steps 2 status)
string(JSON reason GET "${report}" steps 2 reason)
if(NOT deferred STREQUAL "check-at-execution" OR NOT reason STREQUAL "earlier-step-may-change-state")
  message(FATAL_ERROR "default entry was checked ahead of an action: ${report}")
endif()

# A released archive may need sibling resources when run from a project directory.
set(archive_tree "${root}/version archive")
file(MAKE_DIRECTORY "${archive_tree}/Bin" "${archive_tree}/bin")
if(WIN32)
  set(archive_entry "Bin/build.exe")
  configure_file("${TOOL_2}" "${archive_tree}/${archive_entry}" COPYONLY)
else()
  set(archive_entry "Bin/build")
  file(WRITE "${archive_tree}/${archive_entry}" [=[#!/bin/sh
cat "$0.sibling" > "$2"
]=])
  file(CHMOD "${archive_tree}/${archive_entry}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
endif()
file(WRITE "${archive_tree}/${archive_entry}.sibling" "3")
# The archive spells one implicit parent both ways. Case-sensitive volumes
# retain both directories and case-insensitive volumes retain a single one.
file(WRITE "${archive_tree}/bin/helper.dat" "helper")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${repo}/builder.tar" --format=gnutar
  "${archive_entry}" "${archive_entry}.sibling" bin/helper.dat
  WORKING_DIRECTORY "${archive_tree}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${repo}/builder.tar" hash)
file(APPEND "${repo}/catalog" "builder\t3\tarchive\tbuilder.tar\t${hash}\t${archive_entry}\n")
set(caps run tool)
set(select_archive "{op:'tool',registry:'sdk',name:'builder',version:'3'}")
file(WRITE "${bundle}/main.mjs" "export default () => [${select_archive},
  {op:'run',tool:'builder',args:['--sibling','archive result']}]")
seal()
invoke(lock 0)
invoke(apply 0)
file(READ "${work}/archive result" actual)
if(NOT actual STREQUAL "3")
  message(FATAL_ERROR "locked archive failed to read its sibling: ${actual}")
endif()
check_default(2)

# The archive's entry remains intact when a sibling changes.
set(archive_bin "${root}/archive default bin")
set(ENV{BRW_BIN_DIR} "${archive_bin}")
set(caps tool default)
file(WRITE "${bundle}/main.mjs" "export default () => [${select_archive},{op:'default',tool:'builder'}]")
seal()
invoke(apply 0)
invoke(preview 0)
check_entry_status(satisfied)
invoke(apply 0)
check_entry_status(satisfied)
set(installed_sibling "$ENV{XDG_DATA_HOME}/burrow/packages/builder/3/${archive_entry}.sibling")
file(WRITE "${installed_sibling}" "4")
check_modified_payload("${installed_sibling}" "${archive_bin}/${command_name}")
file(WRITE "${installed_sibling}" "3")
set(ENV{BRW_BIN_DIR} "${bin}")
set(caps tool run)

# Even with a matching executable on PATH, ambiguous or unbound actions fail preflight.
set(work "${root}/rejected tool workspace")
file(MAKE_DIRECTORY "${work}")
set(mark "{op:'run',program:'${CMAKE_COMMAND}',args:['-E','touch','started']}")
set(run_bound "{op:'run',tool:'builder',args:['unexpected']}")
foreach(suffix IN ITEMS "" ",${select_archive}")
  file(WRITE "${bundle}/main.mjs" "export default () => [${mark},${run_bound}${suffix}]")
  seal()
  reject(undeclared-tool)
endforeach()
file(WRITE "${bundle}/main.mjs" "export default () => [${select_archive},${mark},
  {op:'run',program:'builder',tool:'builder',args:['unexpected']}]")
seal()
reject(invalid-command)

if(WIN32)
  # The package name differs from its batch entry. Validate the entry's argument rules
  # during preflight, before any earlier command can write to the workspace.
  file(WRITE "${archive_tree}/batch.cmd" "@exit /b 0\r\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${repo}/batch.tar" --format=gnutar
    batch.cmd WORKING_DIRECTORY "${archive_tree}" COMMAND_ERROR_IS_FATAL ANY)
  file(SHA256 "${repo}/batch.tar" hash)
  file(APPEND "${repo}/catalog" "batchtool\t1\tarchive\tbatch.tar\t${hash}\tbatch.cmd\n")
  file(WRITE "${bundle}/main.mjs" "export default () => [
    {op:'tool',registry:'sdk',name:'batchtool',version:'1'},${mark},
    {op:'run',tool:'batchtool',args:['literal|argument']}]")
  seal()
  invoke(lock 0)
  reject(batch-arguments)
endif()

# An earlier environment step can select a different entry directory for this invocation.
set(project_bin "${root}/project commands")
set(caps tool env default)
set(expected_steps 3)
set(bin_key BRW_BIN_DIR)
if(WIN32)
  set(bin_key BrW_Bin_Dir)
endif()
file(WRITE "${bundle}/main.mjs" "export default () => [
  {op:'tool',registry:'sdk',name:'builder',version:'1'},
  {op:'env',name:'${bin_key}',value:'${project_bin}'},{op:'default',tool:'builder'}]")
seal()
invoke(lock 0)
invoke(preview 0)
string(JSON planned_entry GET "${report}" steps 2 entry)
file(TO_CMAKE_PATH "${planned_entry}" planned_entry)
if(NOT planned_entry STREQUAL "${project_bin}/${command_name}" OR EXISTS "${project_bin}")
  message(FATAL_ERROR "preview did not project the declared entry directory: ${report}")
endif()
invoke(apply 0)
execute_process(COMMAND "${project_bin}/${command_name}" OUTPUT_VARIABLE selected OUTPUT_STRIP_TRAILING_WHITESPACE
  COMMAND_ERROR_IS_FATAL ANY)
if(NOT selected STREQUAL "1")
  message(FATAL_ERROR "default under the declared directory ran version '${selected}'")
endif()
check_default(2)
set(expected_steps 2)

# An unowned entry must survive a failed default switch.
set(other_bin "${root}/unmanaged bin")
file(MAKE_DIRECTORY "${other_bin}")
set(ENV{BRW_BIN_DIR} "${other_bin}")
file(WRITE "${other_bin}/${command_name}" "user-owned")
set(caps tool default)
file(WRITE "${bundle}/main.mjs" "export default () => [${select_tool},{op:'default',tool:'builder'}]")
seal()
invoke(lock 0)
invoke(apply 1)
file(READ "${other_bin}/${command_name}" preserved)
if(NOT preserved STREQUAL "user-owned")
  message(FATAL_ERROR "failed default switch overwrote an unrelated command entry")
endif()
check_default(2)

if(WIN32)
  set(ENV{BRW_BIN_DIR} "${bin}")
  # A later ordinary install can expose a version first used only by an action.
  file(SHA256 "${repo}/v1.exe" solo_hash)
  file(APPEND "${repo}/catalog" "solo\t1\texe\tv1.exe\t${solo_hash}\tsolo.exe\n")
  set(caps tool run)
  file(WRITE "${bundle}/main.mjs" "export default () => [
    {op:'tool',registry:'sdk',name:'solo',version:'1'},
    {op:'run',tool:'solo',args:['solo version']}]")
  seal()
  invoke(lock 0)
  invoke(apply 0)
  if(EXISTS "${bin}/solo.exe")
    message(FATAL_ERROR "scoped action published an entry for solo")
  endif()
  set(inactive "$ENV{XDG_DATA_HOME}/burrow/packages/solo/1/solo.exe")
  file(WRITE "${inactive}" "changed after the action")
  execute_process(COMMAND "${BRW}" install sdk/solo --json RESULT_VARIABLE rc OUTPUT_VARIABLE modified)
  string(JSON error GET "${modified}" error)
  if(NOT rc EQUAL 1 OR NOT error STREQUAL "version-conflict" OR EXISTS "${bin}/solo.exe")
    message(FATAL_ERROR "normal install exposed a modified version: ${modified}")
  endif()
  configure_file("${repo}/v1.exe" "${inactive}" COPYONLY)
  execute_process(COMMAND "${BRW}" install sdk/solo --json RESULT_VARIABLE rc OUTPUT_VARIABLE installed)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "normal install rejected its verified inactive version: ${installed}")
  endif()
  execute_process(COMMAND "${bin}/solo.exe" OUTPUT_VARIABLE solo OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY)
  if(NOT solo STREQUAL "1")
    message(FATAL_ERROR "normal install exposed the wrong version: ${solo}")
  endif()
  execute_process(COMMAND "${BRW}" install sdk/solo --json RESULT_VARIABLE rc OUTPUT_VARIABLE again)
  string(JSON error GET "${again}" error)
  if(NOT rc EQUAL 1 OR NOT error STREQUAL "destination-exists")
    message(FATAL_ERROR "an existing active install was replaced: ${again}")
  endif()

  # A user-created version directory with the same bytes has no installation receipt.
  file(APPEND "${repo}/catalog" "unowned\t1\texe\tv1.exe\t${solo_hash}\tunowned.exe\n")
  set(foreign "$ENV{XDG_DATA_HOME}/burrow/packages/unowned/1")
  file(MAKE_DIRECTORY "${foreign}")
  configure_file("${repo}/v1.exe" "${foreign}/unowned.exe" COPYONLY)
  execute_process(COMMAND "${BRW}" install sdk/unowned --json RESULT_VARIABLE rc OUTPUT_VARIABLE collision)
  string(JSON error GET "${collision}" error)
  if(NOT rc EQUAL 1 OR NOT error STREQUAL "destination-exists" OR EXISTS "${bin}/unowned.exe")
    message(FATAL_ERROR "existing directory was claimed: ${collision}")
  endif()
  # An action may use a pinned executable even when its public entry directory is unusable.
  set(ENV{BRW_BIN_DIR} "${repo}/v1.exe")
  file(REMOVE "${work}/solo version")
  invoke(apply 0)
  file(READ "${work}/solo version" solo)
  if(NOT solo STREQUAL "1")
    message(FATAL_ERROR "the action did not run its pinned executable")
  endif()
endif()
