# The builder and its direct helper each invoke their dependency by executable name.
set(bundle "${root}/dependent kit")
set(repo "${root}/dependent catalog")
set(work "${root}/dependent workspace")
set(bin "${root}/dependent bin")
file(MAKE_DIRECTORY "${bundle}" "${repo}" "${work}" "${bin}")
foreach(dir CONFIG CACHE DATA STATE)
  set(ENV{XDG_${dir}_HOME} "${root}/dependent ${dir}")
endforeach()
set(ENV{BRW_BIN_DIR} "${bin}")
if(WIN32)
  set(ext ".cmd")
  set(ENV{PATH} "${bin};$ENV{PATH}")
  set(builder "@call direct-helper.cmd %1\r\n")
  set(direct "@call actual-helper.cmd %1\r\n")
  # Keep the numeric version separate from cmd.exe's redirection descriptor.
  set(locked "@if \"%~1\"==\"--check\" exit /b 0\r\n@> %1 echo 2\r\n")
  set(ambient "@if \"%~1\"==\"--check\" exit /b 1\r\n@> %1 echo 1\r\n")
  set(ordinary "{op:'run',program:'cmd.exe',args:['/d','/c','actual-helper.cmd ambient.txt']}")
else()
  set(ext "")
  set(ENV{PATH} "${bin}:$ENV{PATH}")
  set(builder "#!/bin/sh\nexec direct-helper \"$1\"\n")
  set(direct "#!/bin/sh\nexec actual-helper \"$1\"\n")
  set(locked "#!/bin/sh\nif [ \"$1\" = --check ]; then exit 0; fi\necho 2 > \"$1\"\n")
  set(ambient "#!/bin/sh\nif [ \"$1\" = --check ]; then exit 1; fi\necho 1 > \"$1\"\n")
  set(ordinary "{op:'run',program:'actual-helper',args:['ambient.txt']}")
endif()
file(WRITE "${bin}/actual-helper${ext}" "${ambient}")
file(WRITE "${bin}/direct-helper${ext}" "${direct}")
file(CHMOD "${bin}/actual-helper${ext}" "${bin}/direct-helper${ext}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
set(unrelated "${ambient}")
set(rows "brw-catalog-v1\n")
foreach(name IN ITEMS builder direct locked unrelated)
  if(name STREQUAL "builder")
    set(entry "build${ext}")
    set(deps "direct")
  elseif(name STREQUAL "direct")
    set(entry "direct-helper${ext}")
    set(deps "locked")
  else()
    set(entry "actual-helper${ext}")
    set(deps "")
  endif()
  file(WRITE "${repo}/${name}.bin" "${${name}}")
  file(SHA256 "${repo}/${name}.bin" hash)
  string(APPEND rows "${name}\t2\texe\t${name}.bin\t${hash}\t${entry}\t${deps}\n")
endforeach()
file(WRITE "${repo}/catalog" "${rows}")
execute_process(COMMAND "${BRW}" source add dependent "${repo}/catalog" COMMAND_ERROR_IS_FATAL ANY)
set(modules main.mjs)
set(payloads "")
set(caps tool run state)
set(expected_steps 6)
set(select_tool "{op:'tool',name:'builder',version:'2'}")
file(WRITE "${bundle}/main.mjs" "export default () => [
  {op:'tool',name:'unrelated',version:'2'},${select_tool},
  {op:'run',tool:'builder',args:['locked.txt']},${ordinary},
  {op:'state',check:{program:'${CMAKE_COMMAND}',args:['-E','compare_files','locked.txt','state.txt']},
   unmet:[1],change:{tool:'builder',args:['state.txt']}},
  {op:'state',check:{tool:'builder',args:['--check']},unmet:[],
   change:{program:'${CMAKE_COMMAND}',args:['-E','false']}}]")
seal()
invoke(lock 0)
invoke(apply 0)
file(READ "${work}/locked.txt" locked_version)
file(READ "${work}/ambient.txt" ambient_version)
string(STRIP "${locked_version}" locked_version)
string(STRIP "${ambient_version}" ambient_version)
if(NOT locked_version STREQUAL "2" OR NOT ambient_version STREQUAL "1" OR
   EXISTS "$ENV{XDG_DATA_HOME}/burrow/packages/unrelated/2")
  message(FATAL_ERROR "incorrect scoped dependency selection: locked=${locked_version}, ambient=${ambient_version}")
endif()

# An explicit default also prepares its dependency closure without publishing their commands.
set(ENV{XDG_DATA_HOME} "${root}/dependent default data")
set(caps tool default)
set(expected_steps 2)
file(WRITE "${bundle}/main.mjs" "export default () => [${select_tool},{op:'default',tool:'builder'}]")
seal()
invoke(lock 0)
invoke(apply 0)
if(NOT EXISTS "$ENV{XDG_DATA_HOME}/burrow/packages/locked/2/actual-helper${ext}" OR
   NOT EXISTS "$ENV{XDG_DATA_HOME}/burrow/packages/direct/2/direct-helper${ext}" OR
   EXISTS "${bin}/direct" OR EXISTS "${bin}/direct.exe" OR EXISTS "${bin}/locked" OR EXISTS "${bin}/locked.exe")
  message(FATAL_ERROR "default did not materialize its private dependencies")
endif()
