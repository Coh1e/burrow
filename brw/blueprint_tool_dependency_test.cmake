# The builder and its direct helper each invoke their dependency by executable name.
set(bundle "${root}/dependent kit")
set(repo "${root}/dependent catalog")
set(work "${root}/dependent workspace")
set(bin "${root}/dependent bin")
file(MAKE_DIRECTORY "${bundle}" "${repo}" "${work}" "${bin}")
foreach(dir CONFIG CACHE DATA STATE)
  set(ENV{XDG_${dir}_HOME} "${root}/dependent ${dir}")
endforeach()
set(ENV{BRW_BIN_DIR} "${bin}")
if(WIN32)
  set(ext ".cmd")
  set(public_entry "${bin}/builder.exe")
  set(ENV{PATH} "${bin};$ENV{PATH}")
  set(builder "@call direct-helper.cmd %1\r\n")
  set(direct "@call actual-helper.cmd %1\r\n")
  # Keep the numeric version separate from cmd.exe's redirection descriptor.
  set(locked "@if \"%~1\"==\"--check\" exit /b 0\r\n@> %1 echo 2\r\n")
  set(ambient "@if \"%~1\"==\"--check\" exit /b 1\r\n@> %1 echo 1\r\n")
  set(ambient_direct "@if \"%~1\"==\"--check\" exit /b 1\r\n@> %1 echo old-direct\r\n")
  set(ordinary "{op:'run',program:'cmd.exe',args:['/d','/c','actual-helper.cmd ambient.txt']}")
else()
  set(ext "")
  set(public_entry "${bin}/builder")
  set(ENV{PATH} "${bin}:$ENV{PATH}")
  set(builder "#!/bin/sh\nexec direct-helper \"$1\"\n")
  set(direct "#!/bin/sh\nexec actual-helper \"$1\"\n")
  set(locked "#!/bin/sh\nif [ \"$1\" = --check ]; then exit 0; fi\necho 2 > \"$1\"\n")
  set(ambient "#!/bin/sh\nif [ \"$1\" = --check ]; then exit 1; fi\necho 1 > \"$1\"\n")
  set(ambient_direct "#!/bin/sh\nif [ \"$1\" = --check ]; then exit 1; fi\necho old-direct > \"$1\"\n")
  set(ordinary "{op:'run',program:'actual-helper',args:['ambient.txt']}")
endif()
file(WRITE "${bin}/actual-helper${ext}" "${ambient}")
file(WRITE "${bin}/direct-helper${ext}" "${ambient_direct}")
file(CHMOD "${bin}/actual-helper${ext}" "${bin}/direct-helper${ext}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
set(unrelated "${ambient}")
set(rows "brw-catalog-v1\n")
foreach(name IN ITEMS builder direct locked unrelated)
  if(name STREQUAL "builder")
    set(entry "build${ext}")
    set(deps "direct")
  elseif(name STREQUAL "direct")
    set(entry "direct-helper${ext}")
    set(deps "locked")
  else()
    set(entry "actual-helper${ext}")
    set(deps "")
  endif()
  file(WRITE "${repo}/${name}.bin" "${${name}}")
  file(SHA256 "${repo}/${name}.bin" hash)
  string(APPEND rows "${name}\t2\texe\t${name}.bin\t${hash}\t${entry}\t${deps}\n")
endforeach()
file(WRITE "${repo}/catalog" "${rows}")
execute_process(COMMAND "${BRW}" source add dependent "${repo}/catalog" COMMAND_ERROR_IS_FATAL ANY)
set(modules main.mjs)
set(payloads "")
set(caps tool run state)
set(expected_steps 6)
set(select_tool "{op:'tool',name:'builder',version:'2'}")
file(WRITE "${bundle}/main.mjs" "export default () => [
  {op:'tool',name:'unrelated',version:'2'},${select_tool},
  {op:'run',tool:'builder',args:['locked.txt']},${ordinary},
  {op:'state',check:{program:'${CMAKE_COMMAND}',args:['-E','compare_files','locked.txt','state.txt']},
   unmet:[1],change:{tool:'builder',args:['state.txt']}},
  {op:'state',check:{tool:'builder',args:['--check']},unmet:[],
   change:{program:'${CMAKE_COMMAND}',args:['-E','false']}}]")
seal()
invoke(lock 0)
invoke(apply 0)

function(check_helper_output output expected)
  file(READ "${work}/${output}" actual)
  string(STRIP "${actual}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${output}: expected helper '${expected}', got '${actual}'")
  endif()
endfunction()
check_helper_output("locked.txt" "2")
check_helper_output("ambient.txt" "1")
if(EXISTS "$ENV{XDG_DATA_HOME}/burrow/packages/unrelated/2")
  message(FATAL_ERROR "running the builder installed an unrelated tool")
endif()

# An explicit default also prepares its dependency closure without publishing their commands.
set(ENV{XDG_DATA_HOME} "${root}/dependent default data")
set(caps tool default)
set(expected_steps 2)
file(WRITE "${bundle}/main.mjs" "export default () => [${select_tool},{op:'default',tool:'builder'}]")
seal()
invoke(lock 0)
invoke(apply 0)
if(NOT EXISTS "$ENV{XDG_DATA_HOME}/burrow/packages/locked/2/actual-helper${ext}" OR
   NOT EXISTS "$ENV{XDG_DATA_HOME}/burrow/packages/direct/2/direct-helper${ext}" OR
   EXISTS "${bin}/direct" OR EXISTS "${bin}/direct.exe" OR EXISTS "${bin}/locked" OR EXISTS "${bin}/locked.exe")
  message(FATAL_ERROR "default did not materialize its private dependencies")
endif()
function(check_default_helper command output expected)
  execute_process(COMMAND "${command}" "${output}" WORKING_DIRECTORY "${work}" COMMAND_ERROR_IS_FATAL ANY)
  check_helper_output("${output}" "${expected}")
endfunction()
check_default_helper("${public_entry}" "default version.txt" "2")
set(installed_helper "$ENV{XDG_DATA_HOME}/burrow/packages/locked/2/actual-helper${ext}")
file(WRITE "${installed_helper}" "${ambient}")
check_modified_payload("${installed_helper}" "${public_entry}")
file(WRITE "${installed_helper}" "${locked}")

# The tool declaration prepared its bytes before the Blueprint changed the cache directory.
set(ENV{BRW_BIN_DIR} "${root}/cache switch bin")
set(caps tool env run default)
set(expected_steps 4)
file(WRITE "${bundle}/main.mjs" "export default () => [${select_tool},
  {op:'env',name:'XDG_CACHE_HOME',value:'${root}/new cache'},
  {op:'run',tool:'builder',args:['cache action.txt']},{op:'default',tool:'builder'}]")
seal()
invoke(lock 0)
invoke(preview 0)
invoke(apply 0)
check_helper_output("cache action.txt" "2")
get_filename_component(command_name "${public_entry}" NAME)
check_default_helper("$ENV{BRW_BIN_DIR}/${command_name}" "cache default.txt" "2")

# Only the transitive helper changes. A scoped run keeps the old closure
# accessible through the default until the separate default state is applied.
set(ENV{BRW_BIN_DIR} "${bin}")
string(REPLACE "echo 2" "echo 3" next_helper "${locked}")
file(WRITE "${repo}/next-helper.bin" "${next_helper}")
file(SHA256 "${repo}/next-helper.bin" hash)
file(APPEND "${repo}/catalog" "locked\t3\texe\tnext-helper.bin\t${hash}\tactual-helper${ext}\n")
set(expected_steps 2)
set(caps tool run)
file(WRITE "${bundle}/main.mjs" "export default () => [${select_tool},
  {op:'run',tool:'builder',args:['next locked.txt']}]")
seal()
invoke(lock 0)
invoke(apply 0)
check_helper_output("next locked.txt" "3")
check_default_helper("${public_entry}" "previous default.txt" "2")

set(caps tool default)
file(WRITE "${bundle}/main.mjs" "export default () => [${select_tool},{op:'default',tool:'builder'}]")
seal()
function(check_default_preview expected)
  invoke(preview 0)
  string(JSON actual GET "${report}" steps 1 status)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "expected default selection ${expected}, got ${actual}: ${report}")
  endif()
endfunction()
check_default_preview(unmet)
invoke(apply 0)
check_default_helper("${public_entry}" "updated default.txt" "3")
check_default_preview(satisfied)

if(WIN32)
  # Model a prior valid launcher using the other shipped image and its receipt.
  # Ordinary install provides the target-only sidecar used by older versions.
  set(ENV{BRW_BIN_DIR} "${root}/upgrade bin")
  set(ENV{XDG_DATA_HOME} "${root}/upgrade data")
  set(ENV{XDG_STATE_HOME} "${root}/upgrade state")
  configure_file("${GUI_SHIM}" "${repo}/gui.exe" COPYONLY)
  file(SHA256 "${repo}/gui.exe" gui_digest)
  # The ordinary installer expects a single candidate for each dependency.
  file(READ "${repo}/catalog" catalog)
  string(REGEX REPLACE "\nlocked\t2\t[^\n]*" "" catalog "${catalog}")
  file(WRITE "${repo}/catalog" "${catalog}graphical\t1\texe\tgui.exe\t${gui_digest}\tgui.exe\n")
  foreach(package IN ITEMS builder graphical)
    execute_process(COMMAND "${BRW}" install "dependent/${package}" --json COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  set(upgrade_entry "$ENV{BRW_BIN_DIR}/builder.exe")
  set(packages "$ENV{XDG_DATA_HOME}/burrow/packages")
  file(SHA256 "${upgrade_entry}" expected_shim)
  configure_file("$ENV{BRW_BIN_DIR}/graphical.exe" "${upgrade_entry}" COPYONLY)
  configure_file("${packages}/graphical/1/.brw-shim" "${packages}/builder/2/.brw-shim" COPYONLY)
  check_default_preview(unmet)
  invoke(apply 0)
  file(SHA256 "${upgrade_entry}" installed_shim)
  if(NOT installed_shim STREQUAL expected_shim)
    message(FATAL_ERROR "switching the active version's dependency PATH kept the old launcher")
  endif()
  check_default_helper("${upgrade_entry}" "upgraded default.txt" "3")
  check_default_preview(satisfied)
endif()
