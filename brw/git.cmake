set(git_source "${CMAKE_CURRENT_SOURCE_DIR}/../.local/deps/sources/libgit2-1.9.7")
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_CLI OFF CACHE BOOL "" FORCE)
set(USE_SSH OFF CACHE STRING "" FORCE)
set(REGEX_BACKEND builtin CACHE STRING "" FORCE)
if(WIN32)
  set(USE_HTTPS WinHTTP CACHE STRING "" FORCE)
else()
  # The portable contract fixture only needs local Git transport.
  set(USE_HTTPS OFF CACHE STRING "" FORCE)
endif()
if(TARGET zlibstatic)
  # Archive and Git must link the same pinned zlib in a combined build.
  set(USE_BUNDLED_ZLIB OFF CACHE BOOL "" FORCE)
  set(CMAKE_DISABLE_FIND_PACKAGE_ZLIB TRUE)
  set(ZLIB_INCLUDE_DIRS "${ZLIB_INCLUDE_DIR}")
  set(ZLIB_LIBRARIES "$<BUILD_INTERFACE:zlibstatic>")
else()
  set(USE_BUNDLED_ZLIB ON CACHE BOOL "" FORCE)
endif()
add_subdirectory("${git_source}" git2 EXCLUDE_FROM_ALL)
unset(CMAKE_DISABLE_FIND_PACKAGE_ZLIB)
add_library(brw_worktree STATIC git_worktree.c)
target_include_directories(brw_worktree SYSTEM PRIVATE "${git_source}/include")
target_link_libraries(brw_worktree PRIVATE libgit2package)
target_compile_options(brw_worktree PRIVATE -Wall -Wextra -Wpedantic -Werror)
if(BUILD_TESTING)
  add_executable(brw_git_test git_worktree_test.c)
  target_include_directories(brw_git_test SYSTEM PRIVATE "${git_source}/include")
  target_link_libraries(brw_git_test PRIVATE brw_worktree libgit2package)
  add_test(NAME git_worktree COMMAND "${CMAKE_COMMAND}"
    "-DRUNNER=$<TARGET_FILE:brw_git_test>" -P "${CMAKE_CURRENT_SOURCE_DIR}/git_worktree_test.cmake")
endif()
