function(invoke mode expected)
  execute_process(COMMAND "${BRW}" blueprint ${mode} "${bundle}" --sha256 "${trusted}"
    --workspace "${work}" --json RESULT_VARIABLE rc OUTPUT_VARIABLE report ERROR_VARIABLE stderr TIMEOUT 12)
  if(NOT "${rc}" STREQUAL "${expected}")
    message(FATAL_ERROR "${mode}: expected exit ${expected}; got ${rc}: ${report}${stderr}")
  endif()
  string(JSON status GET "${report}" status)
  string(JSON completed GET "${report}" completed)
  if(expected EQUAL 0 AND mode STREQUAL "preview" AND (NOT status STREQUAL "planned" OR completed))
    message(FATAL_ERROR "incorrect preview status: ${report}")
  elseif(expected EQUAL 0 AND mode STREQUAL "apply" AND
         (NOT status STREQUAL "applied" OR NOT completed EQUAL expected_steps))
    message(FATAL_ERROR "incorrect execution status: ${report}")
  elseif(NOT expected EQUAL 0 AND NOT status STREQUAL "failed")
    message(FATAL_ERROR "incorrect failure status: ${report}")
  endif()
  set(report "${report}" PARENT_SCOPE)
endfunction()
