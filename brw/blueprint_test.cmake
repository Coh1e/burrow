function(reject expected_error)
  foreach(mode preview apply)
    invoke(${mode} 1)
    string(JSON reason GET "${report}" error)
    string(JSON completed GET "${report}" completed)
    file(GLOB files "${work}/*")
    if(NOT reason STREQUAL expected_error OR NOT completed EQUAL 0 OR files)
      message(FATAL_ERROR "${mode} expected ${expected_error} before first write: ${report} ${files}")
    endif()
    if(ARGC GREATER 1)
      string(JSON detail GET "${report}" detail)
      if(NOT detail MATCHES "${ARGV1}")
        message(SEND_ERROR "${mode}: expected child call location matching '${ARGV1}': ${detail}")
      endif()
    endif()
  endforeach()
endfunction()
