function(seal)
  set(manifest "brw-blueprint-v1\nentry\tmain.mjs\nplatform\tany\narch\tany\n")
  foreach(cap IN LISTS caps)
    string(APPEND manifest "requires\t${cap}\n")
  endforeach()
  foreach(kind module payload)
    foreach(path IN LISTS ${kind}s)
      file(SHA256 "${bundle}/${path}" hash)
      string(APPEND manifest "${kind}\t${path}\t${hash}\n")
    endforeach()
  endforeach()
  file(WRITE "${bundle}/blueprint.manifest" "${manifest}")
  file(SHA256 "${bundle}/blueprint.manifest" trusted)
  set(trusted "${trusted}" PARENT_SCOPE)
endfunction()

