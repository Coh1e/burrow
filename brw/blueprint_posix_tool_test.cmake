# Long native package paths are independent of the Blueprint bundle path limit.
set(bundle "${root}/posix-tool-kit")
set(repo "${root}/posix-tool-source")
set(work "${root}/posix-tool-work")
set(tree "${root}/posix-tool-archive")
set(bin "${root}/posix-tool-bin")
foreach(directory CONFIG CACHE DATA STATE)
  set(ENV{XDG_${directory}_HOME} "${root}/posix-tool-${directory}")
endforeach()
set(ENV{XDG_DATA_HOME} "${root}/posix user's data")
set(ENV{BRW_BIN_DIR} "${bin}")
file(MAKE_DIRECTORY "${bundle}" "${repo}" "${work}" "${tree}" "${bin}")
string(REPEAT a 120 first)
string(REPEAT b 120 second)
file(MAKE_DIRECTORY "${tree}/${first}/${second}")
set(rows "brw-catalog-v1\n")
foreach(length IN ITEMS 255 256 259)
  math(EXPR tail "${length} - 242")
  string(REPEAT c ${tail} leaf)
  set(entry "${first}/${second}/${leaf}")
  file(WRITE "${tree}/${entry}" [=[#!/bin/sh
cat "$(dirname "$0")/marker" > "$1"
]=])
  file(WRITE "${tree}/${first}/${second}/marker" "${length}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${repo}/tool-${length}.tar" --format=gnutar
    "${entry}" "${first}/${second}/marker" WORKING_DIRECTORY "${tree}" COMMAND_ERROR_IS_FATAL ANY)
  file(SHA256 "${repo}/tool-${length}.tar" digest)
  string(APPEND rows "builder\t${length}\tarchive\ttool-${length}.tar\t${digest}\t${entry}\n")
endforeach()
file(WRITE "${repo}/catalog" "${rows}")
execute_process(COMMAND "${BRW}" source add kit "${repo}/catalog" COMMAND_ERROR_IS_FATAL ANY)
set(modules main.mjs)
set(payloads "")
set(caps tool run)
set(expected_steps 2)
foreach(length IN ITEMS 255 256 259)
  set(tool "{op:'tool',registry:'kit',name:'builder',version:'${length}'}")
  file(WRITE "${bundle}/main.mjs"
    "export default () => [${tool},{op:'run',tool:'builder',args:['result']}]")
  seal()
  invoke(lock 0)
  invoke(preview 0)
  invoke(apply 0)
  file(READ "${work}/result" actual)
  if(NOT actual STREQUAL "${length}\n")
    message(FATAL_ERROR "wrong archive entry for ${length}-byte path: ${actual}")
  endif()
endforeach()

# The public launcher must preserve the real script path and literal arguments.
set(caps tool default)
file(WRITE "${bundle}/main.mjs" "export default () => [${tool},{op:'default',tool:'builder'}]")
seal()
invoke(preview 0)
invoke(apply 0)
execute_process(COMMAND "${bin}/builder" "a 'quoted' result" WORKING_DIRECTORY "${work}"
  COMMAND_ERROR_IS_FATAL ANY)
file(READ "${work}/a 'quoted' result" public_version)
if(NOT public_version STREQUAL "259\n")
  message(FATAL_ERROR "launcher failed to run the locked archive with its sibling: ${public_version}")
endif()
set(version_dir "$ENV{XDG_DATA_HOME}/burrow/packages/builder/259")
set(marker "${version_dir}/${first}/${second}/marker")
file(WRITE "${marker}" "different\n")
foreach(mode preview apply)
  invoke(${mode} 1)
  string(JSON error GET "${report}" error)
  if(NOT error STREQUAL "version-conflict")
    message(FATAL_ERROR "${mode} missed a changed archive sibling: ${report}")
  endif()
endforeach()
file(WRITE "${marker}" "259\n")

# New managed entries can switch away from a version with its source offline.
file(WRITE "${bundle}/main.mjs"
  "export default () => [{op:'tool',registry:'kit',name:'builder',version:'256'},{op:'default',tool:'builder'}]")
seal()
invoke(lock 0)
file(RENAME "${repo}/catalog" "${repo}/offline")
invoke(preview 0)
invoke(apply 0)
execute_process(COMMAND "${bin}/builder" result WORKING_DIRECTORY "${work}" COMMAND_ERROR_IS_FATAL ANY)
file(READ "${work}/result" actual)
if(NOT actual STREQUAL "256\n")
  message(FATAL_ERROR "offline switch ran the wrong archive: ${actual}")
endif()
file(RENAME "${repo}/offline" "${repo}/catalog")

# A legacy direct link records a version and entry but not its original source.
set(legacy_bin "${root}/posix legacy bin")
file(MAKE_DIRECTORY "${legacy_bin}")
set(ENV{BRW_BIN_DIR} "${legacy_bin}")
string(REPEAT c 13 legacy_leaf)
file(CREATE_LINK "$ENV{XDG_DATA_HOME}/burrow/packages/builder/255/${first}/${second}/${legacy_leaf}"
  "${legacy_bin}/builder" SYMBOLIC)
file(STRINGS "${repo}/catalog" new_row REGEX "^builder\t259\t")
file(WRITE "${repo}/new-catalog" "brw-catalog-v1\n${new_row}\n")
execute_process(COMMAND "${BRW}" source add newkit "${repo}/new-catalog" COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${bundle}/main.mjs"
  "export default () => [{op:'tool',registry:'newkit',name:'builder',version:'259'},{op:'default',tool:'builder'}]")
seal()
invoke(lock 0)
invoke(preview 0)
invoke(apply 0)
execute_process(COMMAND "${legacy_bin}/builder" result WORKING_DIRECTORY "${work}" COMMAND_ERROR_IS_FATAL ANY)
file(READ "${work}/result" actual)
if(NOT actual STREQUAL "259\n")
  message(FATAL_ERROR "cross-source switch ran the wrong archive: ${actual}")
endif()

# A link into the correct package may still point to the user's own choice of command.
set(installed "$ENV{XDG_DATA_HOME}/burrow/packages/builder/255")
set(bin "${root}/posix user links")
file(MAKE_DIRECTORY "${bin}")
set(ENV{BRW_BIN_DIR} "${bin}")
file(WRITE "${installed}/alternate" "user's alternative")
file(CREATE_LINK "${installed}/alternate" "${bin}/builder" SYMBOLIC)
set(caps tool default)
file(WRITE "${bundle}/main.mjs" "export default () => [${tool},{op:'default',tool:'builder'}]")
seal()
invoke(lock 0)
foreach(mode preview apply)
  invoke(${mode} 1)
  string(JSON error GET "${report}" error)
  file(READ_SYMLINK "${bin}/builder" target)
  if(NOT error STREQUAL "entry-conflict" OR NOT target STREQUAL "${installed}/alternate")
    message(FATAL_ERROR "${mode} did not preserve the user's link: ${report}")
  endif()
endforeach()
