set(bundle "${root}/output kit")
set(work "${root}/output project")
file(MAKE_DIRECTORY "${bundle}" "${work}")
set(modules main.mjs build.mjs test.mjs)
file(WRITE "${bundle}/test.mjs" "export const inputs=['input'];
export default ({input}) => [{op:'run',program:'${CMAKE_COMMAND}',args:['-E','copy',input.archive,'tested']}]")
set(payloads build.cmake)
set(caps run)
set(entry "export default () => [
  {op:'include',module:'build.mjs',args:{mode:'Debug'}},
  {op:'include',module:'build.mjs',args:{mode:'Release'}},
  {op:'include',module:'test.mjs',args:{input:{archive:{from:2,output:'archive'}}}}]")
file(WRITE "${bundle}/main.mjs" "${entry}")
file(WRITE "${bundle}/build.mjs" "export const outputs=['archive'];
export default ({mode}) => [{op:'run',program:'${CMAKE_COMMAND}',
  args:['-P',{payload:'build.cmake'},mode,{outputFile:'archive'}]}]")
file(WRITE "${bundle}/build.cmake" [=[
string(RANDOM suffix)
set(archive "${CMAKE_ARGV3} ${suffix}.archive")
file(WRITE "${archive}" "${CMAKE_ARGV3}")
file(WRITE "${CMAKE_ARGV4}" "${archive}")
]=])
seal()
set(expected_steps 3)
invoke(preview 0)
file(GLOB preview_files "${work}/*")
if(preview_files)
  message(FATAL_ERROR "preview created ${preview_files}")
endif()
string(JSON producer GET "${report}" steps 2 args 2 from)
string(JSON name GET "${report}" steps 2 args 2 output)
if(NOT producer STREQUAL "main.mjs[2]" OR NOT name STREQUAL "archive")
  message(FATAL_ERROR "wrong output source: ${report}")
endif()
invoke(apply 0)
file(READ "${work}/tested" contents)
if(NOT contents STREQUAL "Release")
  message(FATAL_ERROR "test read ${contents}")
endif()

if(WIN32)
  set(other linux)
else()
  set(other windows)
endif()
string(REPLACE "args:{mode:'Release'}" "platform:'${other}',args:{mode:'Release'}" skipped "${entry}")
file(WRITE "${bundle}/main.mjs" "${skipped}")
set(work "${root}/skipped project")
file(MAKE_DIRECTORY "${work}")
seal()
reject(unavailable-output "main.mjs\\[3\\].*main.mjs\\[2\\].*archive")

file(WRITE "${bundle}/main.mjs" "export default () => [
  {op:'run',platform:'${other}',program:'never-run',args:[]}]")
seal()
set(expected_steps 0)
foreach(mode preview apply)
  invoke(${mode} 0)
  string(JSON reason GET "${report}" steps 0 reason)
  if(NOT reason STREQUAL "platform-mismatch")
    message(FATAL_ERROR "missing skip reason: ${report}")
  endif()
endforeach()

file(WRITE "${bundle}/main.mjs" "${entry}")
file(APPEND "${bundle}/build.cmake" "\nif(CMAKE_ARGV3 STREQUAL Release)\n file(WRITE \"\${CMAKE_ARGV4}\" \"\")\nendif()")
seal()
invoke(apply 1)
string(JSON code GET "${report}" error)
string(JSON source GET "${report}" detail)
if(NOT code STREQUAL "missing-output" OR NOT source STREQUAL "main.mjs[2]" OR EXISTS "${work}/tested")
  message(FATAL_ERROR "missing output attributed incorrectly: ${report}")
endif()

file(WRITE "${bundle}/build.cmake" [=[
string(ASCII 255 invalid)
file(WRITE "${CMAKE_ARGV4}" "${invalid}")
file(WRITE "output-file-path" "${CMAKE_ARGV4}")
]=])
seal()
invoke(apply 1)
string(JSON code GET "${report}" error)
string(JSON source GET "${report}" detail)
file(READ "${work}/output-file-path" temporary)
if(NOT code STREQUAL "invalid-output" OR NOT source STREQUAL "main.mjs[1]" OR
   EXISTS "${temporary}" OR EXISTS "${work}/tested")
  message(FATAL_ERROR "invalid output or failed temporary-file cleanup: ${report}")
endif()

set(work "${root}/capability project")
file(MAKE_DIRECTORY "${work}")
string(REPLACE "from:2" "from:'main.mjs[2]'" forged "${entry}")
file(WRITE "${bundle}/main.mjs" "${forged}")
seal()
reject(invalid-output-reference)
file(WRITE "${bundle}/main.mjs" "${entry}")
list(APPEND caps unknown-tool)
seal()
reject(missing-capability "^unknown-tool$")
if(NOT WIN32)
  set(caps run)
  file(WRITE "${bundle}/main.mjs" "export default () => [
    {op:'run',program:'${CMAKE_COMMAND}',args:['-E','touch','early']},
    {op:'install',platform:'windows'}]")
  seal()
  file(APPEND "${bundle}/blueprint.manifest" "optional\tinstall\n")
  file(SHA256 "${bundle}/blueprint.manifest" trusted)
  invoke(preview 0)
  file(WRITE "${bundle}/main.mjs" "export default () => [
    {op:'run',program:'${CMAKE_COMMAND}',args:['-E','touch','early']},{op:'install'}]")
  seal()
  file(APPEND "${bundle}/blueprint.manifest" "optional\tinstall\n")
  file(SHA256 "${bundle}/blueprint.manifest" trusted)
  reject(missing-capability "main.mjs.*install")
endif()
