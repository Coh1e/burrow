# An identical executable can be borrowed for an action. Only a version
# with an installation receipt may become a Burrow-managed public entry.
set(bundle "${root}/borrowed kit")
set(work "${root}/borrowed work")
set(repo "${root}/borrowed catalog")
set(bin "${root}/borrowed bin")
foreach(dir CONFIG CACHE DATA STATE)
  set(ENV{XDG_${dir}_HOME} "${root}/borrowed ${dir}")
endforeach()

set(ENV{BRW_BIN_DIR} "${bin}")
set(foreign "$ENV{XDG_DATA_HOME}/burrow/packages/borrowed/2")
file(MAKE_DIRECTORY "${bundle}" "${work}" "${repo}" "${foreign}")
configure_file("${TOOL_2}" "${repo}/v2.exe" COPYONLY)
configure_file("${TOOL_2}" "${foreign}/borrowed.exe" COPYONLY)
file(SHA256 "${repo}/v2.exe" hash)
file(WRITE "${repo}/catalog" "brw-catalog-v1\nborrowed\t2\texe\tv2.exe\t${hash}\tborrowed.exe\n")
execute_process(COMMAND "${BRW}" source add borrowed "${repo}/catalog" COMMAND_ERROR_IS_FATAL ANY)
set(select "{op:'tool',registry:'borrowed',name:'borrowed',version:'2'}")
set(modules main.mjs)
set(payloads "")
set(caps tool run)
set(expected_steps 2)
file(WRITE "${bundle}/main.mjs" "export default () => [${select},{op:'run',tool:'borrowed',args:['answer']}]")
seal()
invoke(lock 0)
invoke(apply 0)
file(READ "${work}/answer" version)
file(GLOB receipts "$ENV{XDG_STATE_HOME}/burrow/install-*")
if(NOT version STREQUAL "2" OR receipts)
  message(FATAL_ERROR "scoped reuse claimed an existing directory: ${receipts}")
endif()
set(caps tool default)
file(WRITE "${bundle}/main.mjs" "export default () => [${select},{op:'default',tool:'borrowed'}]")
seal()
foreach(mode preview apply)
  invoke(${mode} 1)
  string(JSON error GET "${report}" error)
  file(GLOB receipts "$ENV{XDG_STATE_HOME}/burrow/install-*")
  file(GLOB contents RELATIVE "${foreign}" "${foreign}/*")
  if(NOT error STREQUAL "entry-conflict" OR receipts OR EXISTS "${bin}/borrowed.exe" OR
     NOT contents STREQUAL "borrowed.exe")
    message(FATAL_ERROR "${mode} claimed the borrowed version: ${report} ${contents} ${receipts}")
  endif()
endforeach()

# Interrupt the first materialization after the version move. Recovery must
# roll back the receipt and private version together, without a public bin.
set(ENV{XDG_DATA_HOME} "${root}/interrupted data")
set(ENV{XDG_STATE_HOME} "${root}/interrupted state")
set(ENV{BRW_BIN_DIR} "${repo}/v2.exe")
set(caps tool run)
file(WRITE "${bundle}/main.mjs" "export default () => [${select},{op:'run',tool:'borrowed',args:['recovered']}]")
seal()
set(ENV{BRW_TEST_INTERRUPT} version)
execute_process(COMMAND "${INTERRUPT_BRW}" blueprint apply "${bundle}" --sha256 "${trusted}"
  --workspace "${work}" --json RESULT_VARIABLE interrupted)
unset(ENV{BRW_TEST_INTERRUPT})
if(NOT interrupted EQUAL 86)
  message(FATAL_ERROR "expected interruption after publishing private version, got ${interrupted}")
endif()
execute_process(COMMAND "${BRW}" recover --json COMMAND_ERROR_IS_FATAL ANY)
file(GLOB receipts "$ENV{XDG_STATE_HOME}/burrow/install-*")
if(receipts OR EXISTS "$ENV{XDG_DATA_HOME}/burrow/packages/borrowed/2")
  message(FATAL_ERROR "recovery left a version or receipt behind")
endif()
invoke(apply 0)
file(READ "${work}/recovered" version)
if(NOT version STREQUAL "2")
  message(FATAL_ERROR "retry after recovery ran version '${version}'")
endif()

# Use the selected version as a real default before adding a named stream to it.
set(ENV{BRW_BIN_DIR} "${bin}")
set(caps tool default)
file(WRITE "${bundle}/main.mjs" "export default () => [${select},{op:'default',tool:'borrowed'}]")
seal()
invoke(apply 0)
invoke(preview 0)
string(JSON status GET "${report}" steps 1 status)
if(NOT status STREQUAL "satisfied")
  message(FATAL_ERROR "managed version was not selected: ${report}")
endif()
set(ENV{BRW_TEST_STREAM_FILE} "$ENV{XDG_DATA_HOME}/burrow/packages/borrowed/2/borrowed.exe")
execute_process(COMMAND powershell.exe -NoProfile -NonInteractive -Command
  "try { Set-Content -LiteralPath $env:BRW_TEST_STREAM_FILE -Stream brw-test -Value extra -ErrorAction Stop } catch [System.NotSupportedException] { exit 77 } catch { Write-Error $_; exit 1 }"
  RESULT_VARIABLE stream_status)
unset(ENV{BRW_TEST_STREAM_FILE})
if(stream_status EQUAL 0)
  foreach(mode preview apply)
    invoke(${mode} 1)
    string(JSON error GET "${report}" error)
    if(NOT error STREQUAL "version-conflict")
      message(FATAL_ERROR "${mode} accepted a modified executable: ${report}")
    endif()
  endforeach()
elseif(NOT stream_status EQUAL 77)
  message(FATAL_ERROR "could not prepare the named stream fixture")
endif()
