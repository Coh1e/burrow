cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 id)
set(root "${CMAKE_CURRENT_BINARY_DIR}/ssh fixture ${id}")
file(MAKE_DIRECTORY "${root}")
set(identity "${root}/fixture %h identity")
set(hosts "${root}/known %h hosts")
string(REPLACE "%" "%%" identity_option "${identity}")
file(WRITE "${identity}" "identity fixture\n")
file(WRITE "${hosts}" "host trust fixture\n")
set(ENV{BRW_TEST_SSH_CLIENT} "${CLIENT}")
set(target "operator@host.example.invalid")
set(port 2222)
set(alias "[host.example.invalid]:2222")
set(allow "${target}:${port}")
set(command [=[printf '%s' "hello ssh 世界"]=])

function(check mode authorized preview expected_code expected_status remote_exit)
  set(ENV{BRW_FIXTURE_MODE} "${mode}")
  set(ENV{BRW_FIXTURE_CONNECT} "${root}/${mode}-connect")
  set(ENV{BRW_FIXTURE_SEND} "${root}/${mode}-send")
  set(ENV{BRW_FIXTURE_ARGS} "${root}/${mode}-args")
  set(options --identity "${identity}" --known-hosts "${hosts}" --json)
  if(NOT mode STREQUAL "default-port")
    list(APPEND options --port "${port}")
  endif()
  if(authorized)
    list(APPEND options --allow-target "${authorized}")
  endif()
  if(preview)
    list(APPEND options --dry-run)
  endif()
  if(mode STREQUAL "timeout")
    list(APPEND options --timeout 2)
  endif()
  set(runner "${BRW}")
  if(mode MATCHES "^interrupt-")
    set(ENV{BRW_FIXTURE_PHASE} "${root}/${mode}-phase")
    string(LENGTH "${command}" command_bytes)
    set(ENV{BRW_FIXTURE_COMMAND_BYTES} "${command_bytes}")
    set(runner "${CANCEL}" "${BRW}" "$ENV{BRW_FIXTURE_PHASE}")
  endif()
  execute_process(COMMAND ${runner} ssh "${target}" ${options} -- "${command}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE report ERROR_VARIABLE diagnostics TIMEOUT 10 ENCODING UTF-8)
  if(NOT "${rc}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "${mode}: exit ${rc}, expected ${expected_code}: ${report} ${diagnostics}")
  endif()
  string(JSON status GET "${report}" status)
  string(JSON operation GET "${report}" operation)
  string(JSON exit_type TYPE "${report}" remoteExit)
  if(NOT status STREQUAL expected_status OR NOT operation STREQUAL "ssh")
    message(FATAL_ERROR "${mode}: unexpected report ${report}")
  endif()
  if(remote_exit STREQUAL "null")
    if(NOT exit_type STREQUAL "NULL")
      message(FATAL_ERROR "${mode}: unexpected remote exit ${report}")
    endif()
  else()
    string(JSON result GET "${report}" remoteExit)
    if(NOT exit_type STREQUAL "NUMBER" OR NOT result STREQUAL remote_exit OR
       NOT diagnostics MATCHES "remote output")
      message(FATAL_ERROR "${mode}: missing confirmed exit or output: ${report} ${diagnostics}")
    endif()
  endif()
  if(preview AND authorized)
    string(JSON planned GET "${report}" command)
    string(JSON pending GET "${report}" pending 0)
    if(NOT planned STREQUAL command OR NOT pending STREQUAL "host-identity")
      message(FATAL_ERROR "${mode}: preview lost command or pending host verification")
    endif()
  endif()
  if(preview OR NOT "${authorized}" STREQUAL "${allow}")
    if(EXISTS "$ENV{BRW_FIXTURE_CONNECT}" OR EXISTS "$ENV{BRW_FIXTURE_SEND}")
      message(FATAL_ERROR "${mode}: contacted transport")
    endif()
    return()
  endif()
  file(READ "$ENV{BRW_FIXTURE_CONNECT}" attempts)
  if(NOT attempts STREQUAL "connect\n")
    message(FATAL_ERROR "${mode}: expected exactly one connection")
  endif()
  file(READ "$ENV{BRW_FIXTURE_ARGS}" args)
  foreach(required "StrictHostKeyChecking=yes" "BatchMode=yes"
                   "UpdateHostKeys=no" "VerifyHostKeyDNS=no" "IdentityAgent=none" "ConnectionAttempts=1")
    if(NOT args MATCHES "${required}")
      message(FATAL_ERROR "${mode}: missing required OpenSSH option ${required}")
    endif()
  endforeach()
  foreach(arg "-F\nNUL" "-p\n${port}" "-o\nIdentityFile=\"${identity_option}\""
              "-o\nUserKnownHostsFile=NUL" "-o\nGlobalKnownHostsFile=\"${hosts}\""
              "-o\nHostKeyAlias=${alias}" "--\n${target}")
    string(FIND "${args}" "${arg}\n" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "${mode}: OpenSSH did not receive the expected argument ${arg}")
    endif()
  endforeach()
  string(FIND "${args}" "${command}" exposed)
  if(NOT exposed EQUAL -1)
    message(FATAL_ERROR "${mode}: passed the user command before verifying the host")
  endif()
  if(mode MATCHES "^interrupt-" AND NOT EXISTS "$ENV{BRW_FIXTURE_PHASE}")
    message(FATAL_ERROR "${mode}: peer did not reach its interruption point")
  endif()
  if(mode STREQUAL "identity-mismatch" OR mode STREQUAL "interrupt-before-send")
    if(EXISTS "$ENV{BRW_FIXTURE_SEND}")
      message(FATAL_ERROR "${mode}: sent a command before host verification")
    endif()
  elseif(mode STREQUAL "interrupt-partial-send")
    file(READ "$ENV{BRW_FIXTURE_SEND}" sent)
    if(NOT sent STREQUAL "prefix:")
      message(FATAL_ERROR "${mode}: expected exactly the submitted prefix")
    endif()
  else()
    file(READ "$ENV{BRW_FIXTURE_SEND}" sent)
    if(NOT sent STREQUAL command)
      message(FATAL_ERROR "${mode}: expected exactly one copy of the original command")
    endif()
  endif()
endfunction()

check(preview "${allow}" ON 0 planned null)
check(unauthorized "" OFF 1 rejected null)
check(wrong-port "${target}:22" OFF 1 rejected null)
check(identity-mismatch "${allow}" OFF 1 rejected null)
check(disconnect "${allow}" OFF 1 unknown null)
check(timeout "${allow}" OFF 1 unknown null)
check(wrong-receipt "${allow}" OFF 1 unknown null)
check(success "${allow}" OFF 0 completed 0)
check(exit255 "${allow}" OFF 255 completed 255)
check(interrupt-before-send "${allow}" OFF 1 rejected null)
check(interrupt-after-send "${allow}" OFF 1 unknown null)
string(REPEAT "0123456789ab" 1000 command)
check(long-command "${allow}" OFF 0 completed 0)
string(REPEAT "世界" 8000 tail)
set(command "prefix:${tail}")
check(interrupt-partial-send "${allow}" OFF 1 unknown null)

# Text output guides an operator following a disconnect; rerunning is explicit.
set(ENV{BRW_FIXTURE_MODE} "disconnect")
set(ENV{BRW_FIXTURE_CONNECT} "${root}/text-connect")
set(ENV{BRW_FIXTURE_ARGS} "${root}/text-args")
set(ENV{BRW_FIXTURE_SEND} "${root}/text-send")
execute_process(COMMAND "${BRW}" ssh "${target}" --port ${port} --allow-target "${allow}"
                --identity "${identity}" --known-hosts "${hosts}" -- whoami
                RESULT_VARIABLE rc ERROR_VARIABLE diagnostics TIMEOUT 10)
string(FIND "${diagnostics}" "Check remote state on ${allow} before running the command again" guidance)
if(NOT rc EQUAL 1 OR NOT diagnostics MATCHES "unknown" OR guidance EQUAL -1)
  message(FATAL_ERROR "missing operator guidance after disconnect: ${rc} ${diagnostics}")
endif()

set(command whoami)
set(port 22)
set(alias "host.example.invalid")
set(allow "${target}:${port}")
check(default-port "${allow}" OFF 0 completed 0)
set(target "operator@[::1]")
set(port 2222)
set(alias "[::1]:2222")
set(allow "${target}:${port}")
check(ipv6-port "${allow}" OFF 0 completed 0)
set(ENV{BRW_FIXTURE_CONNECT} "${root}/parse-connect")
set(defaults ssh "${target}" --allow-target "${target}:22" --identity "${identity}"
    --known-hosts "${hosts}" --dry-run --json)
execute_process(COMMAND "${BRW}" ${defaults} -- whoami RESULT_VARIABLE rc OUTPUT_VARIABLE report)
string(JSON port GET "${report}" port)
string(JSON seconds GET "${report}" timeoutSeconds)
if(NOT rc EQUAL 0 OR NOT port EQUAL 22 OR NOT seconds EQUAL 30)
  message(FATAL_ERROR "unexpected preview defaults: ${report}")
endif()
execute_process(COMMAND "${BRW}" ${defaults} --allow-target "${allow}" -- whoami
                RESULT_VARIABLE rc OUTPUT_VARIABLE report)
string(JSON error GET "${report}" error)
if(NOT rc EQUAL 2 OR NOT error STREQUAL "invalid-arguments" OR EXISTS "$ENV{BRW_FIXTURE_CONNECT}")
  message(FATAL_ERROR "duplicate authorization or preview contacted transport: ${report}")
endif()
file(REMOVE_RECURSE "${root}")
