function(state_fixture check)
  file(WRITE "${bundle}/main.mjs" "export default () => [
    ${before}{op:'state',check:${check},unmet:${mapping},change:${change}}${after}]")
  seal()
  set(trusted "${trusted}" PARENT_SCOPE)
endfunction()
set(before "")
set(after "")
set(mapping "[3]")
state_fixture("{program:'${CMAKE_COMMAND}',args:['-E','true']}")
invoke(preview 0)
invoke(apply 0)
if(EXISTS "${work}/changed")
  message(FATAL_ERROR "satisfied state ran its change")
endif()

function(expect_field expected)
  string(JSON actual GET "${report}" ${ARGN})
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "expected ${ARGN} = ${expected}: ${report}")
  endif()
endfunction()
expect_field(satisfied steps 0 status)
if(WIN32)
  set(probe "{program:'cmd.exe',args:['/d','/c','if exist changed (exit 0) else (exit 3)']}")
else()
  set(probe "{program:'sh',args:['-c','test -f changed || exit 3']}")
endif()
state_fixture("${probe}")
invoke(preview 0)
expect_field(unmet steps 0 status)
if(EXISTS "${work}/changed")
  message(FATAL_ERROR "preview ran the change")
endif()
invoke(apply 0)
expect_field(changed steps 0 status)
expect_field(0 steps 0 exitCode)
invoke(apply 0)
expect_field(satisfied steps 0 status)

set(after ",{op:'run',program:'${CMAKE_COMMAND}',args:['-E','touch','later']}")
set(work "${root}/state errors")
file(MAKE_DIRECTORY "${work}")
state_fixture("{program:'${CMAKE_COMMAND}',args:['-E','false']}")
foreach(mode preview apply)
  invoke(${mode} 1)
  expect_field(check-failed error)
  expect_field("main.mjs[1]" detail)
  expect_field(ON commandStarted)
  expect_field(ON mayHaveSideEffects)
  expect_field(1 steps 0 exitCode)
  expect_field(0 completed)
  if(EXISTS "${work}/changed" OR EXISTS "${work}/later")
    message(FATAL_ERROR "${mode} ran a change or subsequent step after a check error")
  endif()
endforeach()
state_fixture("{program:'missing-brw-state-check-139',args:[]}")
begin_boundary("7/check-launch-fails")
foreach(mode preview apply)
  invoke(${mode} 1)
  expect_field(child-launch error)
  expect_field("main.mjs[1]" detail)
  expect_field(0 completed)
  if(EXISTS "${work}/changed" OR EXISTS "${work}/later")
    message(FATAL_ERROR "${mode} continued after the check failed to launch")
  endif()
  observe_boundary("change and later markers absent")
endforeach()
finish_boundary()
set(change "{program:'missing-brw-state-change-140',args:[]}")
state_fixture("${probe}")
invoke(apply 1)
expect_field(child-launch error)
expect_field(3 steps 0 exitCode)
string(JSON field_type ERROR_VARIABLE missing TYPE "${report}" commandStarted)
if(NOT missing)
  expect_field(OFF commandStarted)
endif()
