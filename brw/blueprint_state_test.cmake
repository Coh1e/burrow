expect_field(ON commandStarted)
expect_field(3 steps 0 exitCode)
expect_field(0 completed)
if(EXISTS "${work}/later")
  message(FATAL_ERROR "continued after failed recheck")
endif()
observe_boundary("later marker absent")
finish_boundary()

